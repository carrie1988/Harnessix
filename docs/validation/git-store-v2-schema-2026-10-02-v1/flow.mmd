flowchart TB
    A["已有同连接事务"] --> B{"事务已开启？"}
    B -->|"否"| X["拒绝 · 不建表"]
    B -->|"是"| C["拒绝 temp 对象；受限读取 main.sqlite_schema"]
    C --> D{"精确 v1 / v2 结构？"}
    D -->|"否"| X
    D -->|"是"| U{"数据库 UTF-8？"}
    U -->|"否"| X
    U -->|"是"| E["读取真实 metadata 表版本"]
    E --> F{"版本 1 / 2？"}
    F -->|"否"| X
    F -->|"是"| G{"完整十三表？"}
    G -->|"是"| I["幂等返回；事务和版本不变"]
    G -->|"否"| J{"版本 1 + 精确六表？"}
    J -->|"否"| X
    J -->|"是"| K["同事务 execute 七条 DDL；不读业务行"]
    K --> L["复核完整结构；返回但不提交"]
    K -->|"失败 / 取消"| R["调用方回滚；原六表 / payload 保持"]
    L --> T["后继调用方负责业务迁移；本 helper 不升版本"]
