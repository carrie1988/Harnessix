usage: harnessix code configure [-h] [--config CONFIG]
                                [--provider-kind {openai_chat,anthropic}]
                                [--provider-id PROVIDER_ID]
                                [--profile-id PROFILE_ID]
                                [--base-url BASE_URL] [--model MODEL]
                                [--secret-name SECRET_NAME]
                                [--secret-version SECRET_VERSION]
                                [--api-key-env API_KEY_ENV]
                                [--output-token-parameter {max_completion_tokens,max_tokens}]
                                [--replace]
                                [--expected-source-sha256 EXPECTED_SOURCE_SHA256]
                                [--non-interactive]

