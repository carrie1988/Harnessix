{
  "schema": "harnessix.native-execution-envelope-commands/v3",
  "cwd": "repository root",
  "runtime": "existing locked Python 3.12.7 / pytest 8.4.2",
  "environment": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONPATH": "src:.",
    "GIT_OPTIONAL_LOCKS": "0"
  },
  "formal_argv": [
    "${LOCKED_PYTHON}",
    "-B",
    "-m",
    "pytest",
    "-q",
    "-p",
    "no:cacheprovider",
    "--basetemp",
    "${FRESH_PRIVATE_TEMP_WITHOUT_SPACES}",
    "--junitxml",
    "${PRIVATE_EVIDENCE}/formal.xml",
    "tests/governance/test_windows_git_native_branch_observation.py",
    "tests/governance/test_windows_git_native_branch_preflight_v2.py",
    "tests/governance/test_windows_git_native_selected_layout.py",
    "tests/governance/test_windows_git_native_execution_v3.py"
  ],
  "ruff_argv": [
    "${LOCKED_PYTHON}",
    "-B",
    "-m",
    "ruff",
    "check",
    "--no-cache",
    "scripts/windows_git_native_branch_observation/__init__.py",
    "scripts/windows_git_native_branch_observation/contract.py",
    "scripts/windows_git_native_branch_observation/diagnostics.py",
    "scripts/windows_git_native_branch_observation/identity.py",
    "scripts/windows_git_native_branch_observation/observe.py",
    "scripts/windows_git_native_branch_observation/preflight.py",
    "scripts/windows_git_native_branch_observation/projection.py",
    "scripts/windows_git_native_branch_observation/run_cases.py",
    "tests/governance/test_windows_git_native_branch_observation.py",
    "tests/governance/test_windows_git_native_branch_preflight_v2.py",
    "tests/governance/test_windows_git_native_selected_layout.py",
    "tests/governance/test_windows_git_native_execution_v3.py"
  ],
  "format_argv": [
    "${LOCKED_PYTHON}",
    "-B",
    "-m",
    "ruff",
    "format",
    "--check",
    "--no-cache",
    "scripts/windows_git_native_branch_observation/__init__.py",
    "scripts/windows_git_native_branch_observation/contract.py",
    "scripts/windows_git_native_branch_observation/diagnostics.py",
    "scripts/windows_git_native_branch_observation/identity.py",
    "scripts/windows_git_native_branch_observation/observe.py",
    "scripts/windows_git_native_branch_observation/preflight.py",
    "scripts/windows_git_native_branch_observation/projection.py",
    "scripts/windows_git_native_branch_observation/run_cases.py",
    "tests/governance/test_windows_git_native_branch_observation.py",
    "tests/governance/test_windows_git_native_branch_preflight_v2.py",
    "tests/governance/test_windows_git_native_selected_layout.py",
    "tests/governance/test_windows_git_native_execution_v3.py"
  ],
  "source_reader": [
    "read_contract()",
    "source_checks(repository,contract)"
  ],
  "doc_gate": "当前两份Markdown；正式metadata/links/sections/mermaid检查；基线commit另用只读对象核验",
  "secret_gate": "scan_paths(owned_files)；包含manifest、PNG及原三源快照；完整覆盖才接受0结果",
  "native_execution": "未执行；发布不会自动运行原workflow"
}
