# 本地开发默认使用 SQLite；生产队列模式配置 PostgreSQL URL。
HARNESSIX_DATABASE_URL=
HARNESSIX_DATABASE_PATH=.harnessix/harnessix.db
HARNESSIX_DEMO_DATABASE_PATH=.harnessix/demo-external.db

# 可选值：inline、queued。
HARNESSIX_EXECUTION_MODE=inline
HARNESSIX_HOST=127.0.0.1
HARNESSIX_PORT=8787

HARNESSIX_LEASE_SECONDS=30
HARNESSIX_WORKER_POLL_SECONDS=0.5
HARNESSIX_WORKER_HEARTBEAT_SECONDS=10
HARNESSIX_RECOVERY_INTERVAL_SECONDS=5
