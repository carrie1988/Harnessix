    },
    "before": {
      "$ref": "#/$defs/WorkspaceFileVersion"
    },
    "after": {
      "$ref": "#/$defs/WorkspaceFileVersion"
    },
    "binary": {
      "title": "Binary",
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "path",
    "before",
    "after",
    "binary"
