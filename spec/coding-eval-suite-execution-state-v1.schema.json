{
  "additionalProperties": false,
  "description": "Suite进度账本；只有连续完成前缀可进入聚合。",
  "properties": {
    "spec_version": {
      "const": "harnessix.coding-eval-suite-execution-state/v1",
      "default": "harnessix.coding-eval-suite-execution-state/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "suite_id": {
      "format": "uuid",
      "title": "Suite Id",
      "type": "string"
    },
    "plan_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "execution_config_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Config Fingerprint",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "stopped",
        "completed"
      ],
      "title": "Status",
      "type": "string"
    },
    "completed_case_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Completed Case Ids",
      "type": "array"
    },
    "current_case_id": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Case Id"
    },
    "known_cost_currency": {
      "enum": [
        "USD",
        "CNY"
      ],
      "title": "Known Cost Currency",
      "type": "string"
    },
    "known_cost_amount": {
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$",
      "title": "Known Cost Amount",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "enum": [
            "cancelled",
            "fee_limit_reached",
            "cost_unknown",
            "evidence_missing",
            "runtime_failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "report_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Report Sha256"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "suite_id",
    "plan_fingerprint",
    "execution_config_fingerprint",
    "status",
    "completed_case_ids",
    "known_cost_currency",
    "known_cost_amount",
    "started_at",
    "updated_at"
  ],
  "title": "CodingEvalSuiteExecutionState",
  "type": "object"
}
