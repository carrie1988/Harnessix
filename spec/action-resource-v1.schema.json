      "type": "string"
    },
    "identifier_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identifier Sha256",
      "type": "string"
    },
    "attributes_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Attributes Sha256",
      "type": "string"
