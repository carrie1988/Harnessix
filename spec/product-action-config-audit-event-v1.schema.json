{
  "additionalProperties": false,
  "description": "Action配置加载与激活的连续Hash链事件。",
  "properties": {
    "spec_version": {
      "const": "harnessix.product-action-config-audit-event/v1",
      "default": "harnessix.product-action-config-audit-event/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "operation": {
      "enum": [
        "loaded",
        "activated"
      ],
      "title": "Operation",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "previous_active_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Active Sha256"
    },
    "previous_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Digest"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    }
  },
  "required": [
    "sequence",
    "operation",
    "config_sha256",
    "occurred_at",
    "digest"
  ],
  "title": "ProductActionConfigAuditEvent",
  "type": "object"
}
