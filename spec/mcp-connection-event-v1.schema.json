{
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.mcp-connection-event/v1",
      "default": "harnessix.mcp-connection-event/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "server_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$",
      "title": "Server Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "from_state": {
      "anyOf": [
        {
          "enum": [
            "connecting",
            "connected",
            "schema_changed",
            "failed",
            "closed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "From State"
    },
    "to_state": {
      "enum": [
        "connecting",
        "connected",
        "schema_changed",
        "failed",
        "closed"
      ],
      "title": "To State",
      "type": "string"
    },
    "catalog_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Sha256"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "previous_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Digest"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    }
  },
  "required": [
    "server_id",
    "sequence",
    "from_state",
    "to_state",
    "occurred_at",
    "digest"
  ],
  "title": "McpConnectionEvent",
  "type": "object"
}
