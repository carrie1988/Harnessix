{
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.mcp-connection-snapshot/v1",
      "default": "harnessix.mcp-connection-snapshot/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "server_id": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$",
      "title": "Server Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "connecting",
        "connected",
        "schema_changed",
        "failed",
        "closed"
      ],
      "title": "State",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "generation": {
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "catalog_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Sha256"
    },
    "last_event_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Last Event Digest",
      "type": "string"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "server_id",
    "state",
    "sequence",
    "generation",
    "last_event_digest",
    "updated_at"
  ],
  "title": "McpConnectionSnapshot",
  "type": "object"
}
