{
  "$defs": {
    "EffectClass": {
      "enum": [
        "read_only",
        "idempotent_write",
        "non_idempotent_write",
        "destructive"
      ],
      "title": "EffectClass",
      "type": "string"
    },
    "ExternalRoot": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Location",
          "type": "string"
        },
        "path_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Path Digest",
          "type": "string"
        },
        "identity": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity",
          "type": "string"
        },
        "access": {
          "items": {
            "enum": [
              "read",
              "write",
              "execute"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Access",
          "type": "array"
        }
      },
      "required": [
        "location",
        "path_digest",
        "identity",
        "access"
      ],
      "title": "ExternalRoot",
      "type": "object"
    },
    "GitBaseHistoryBoundary": {
      "additionalProperties": false,
      "description": "保留基线提交父边的原顺序和重复出现，不授权外部历史读取。",
      "properties": {
        "kind": {
          "const": "base_commit_parent_edges",
          "title": "Kind",
          "type": "string"
        },
        "base_commit": {
          "$ref": "#/$defs/GitObjectRead"
        },
        "parents": {
          "items": {
            "$ref": "#/$defs/GitObjectRead"
          },
          "title": "Parents",
          "type": "array"
        },
        "unique_parent_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unique Parent Ids",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "base_commit",
        "parents",
        "unique_parent_ids"
      ],
      "title": "GitBaseHistoryBoundary",
      "type": "object"
    },
    "GitBaselineMember": {
      "additionalProperties": false,
      "description": "原首before的Git树位置；不存在时不伪造空blob。",
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "oid": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Oid"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "100644",
                "100755"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        }
      },
      "required": [
        "path"
      ],
      "title": "GitBaselineMember",
      "type": "object"
    },
    "GitCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "const": "harnessix.git-checkpoint/v1",
          "default": "harnessix.git-checkpoint/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "checkpoint_id": {
          "format": "uuid",
          "title": "Checkpoint Id",
          "type": "string"
        },
        "worktree_id": {
          "format": "uuid",
          "title": "Worktree Id",
          "type": "string"
        },
        "worktree_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Worktree Plan Fingerprint",
          "type": "string"
        },
        "worktree_binding_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Worktree Binding Digest",
          "type": "string"
        },
        "transaction_id": {
          "format": "uuid",
          "title": "Transaction Id",
          "type": "string"
        },
        "transaction_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transaction Plan Fingerprint",
          "type": "string"
        },
        "repository_binding_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Repository Binding Digest",
          "type": "string"
        },
        "base_commit_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Base Commit Oid",
          "type": "string"
        },
        "base_tree_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Base Tree Oid",
          "type": "string"
        },
        "tree_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Tree Oid",
          "type": "string"
        },
        "mutations_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mutations Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "checkpoint_id",
        "worktree_id",
        "worktree_plan_fingerprint",
        "worktree_binding_digest",
        "transaction_id",
        "transaction_plan_fingerprint",
        "repository_binding_digest",
        "base_commit_oid",
        "base_tree_oid",
        "tree_oid",
        "mutations_digest",
        "created_at",
        "digest"
      ],
      "title": "GitCheckpoint",
      "type": "object"
    },
    "GitCommitReferences": {
      "additionalProperties": false,
      "description": "只记录原 tree 及有序 parent；不把 parent 自动声明为外部历史边界。",
      "properties": {
        "tree": {
          "$ref": "#/$defs/GitObjectRead"
        },
        "parents": {
          "items": {
            "$ref": "#/$defs/GitObjectRead"
          },
          "title": "Parents",
          "type": "array"
        }
      },
      "required": [
        "tree",
        "parents"
      ],
      "title": "GitCommitReferences",
      "type": "object"
    },
    "GitCommitSpec": {
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "const": "harnessix.git-commit-spec/v1",
          "default": "harnessix.git-commit-spec/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "commit_id": {
          "format": "uuid",
          "title": "Commit Id",
          "type": "string"
        },
        "checkpoint": {
          "$ref": "#/$defs/GitCheckpoint"
        },
        "branch_ref": {
          "maxLength": 1024,
          "minLength": 12,
          "title": "Branch Ref",
          "type": "string"
        },
        "parent_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Parent Oid",
          "type": "string"
        },
        "tree_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Tree Oid",
          "type": "string"
        },
        "author_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Author Name",
          "type": "string"
        },
        "author_email": {
          "maxLength": 320,
          "minLength": 3,
          "title": "Author Email",
          "type": "string"
        },
        "message": {
          "maxLength": 65536,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "authored_at": {
          "format": "date-time",
          "title": "Authored At",
          "type": "string"
        },
        "hooks_policy": {
          "const": "disabled",
          "default": "disabled",
          "title": "Hooks Policy",
          "type": "string"
        },
        "raw_commit_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Commit Sha256",
          "type": "string"
        },
        "expected_commit_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Expected Commit Oid",
          "type": "string"
        },
        "implementation_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Digest",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "commit_id",
        "checkpoint",
        "branch_ref",
        "parent_oid",
        "tree_oid",
        "author_name",
        "author_email",
        "message",
        "authored_at",
        "raw_commit_sha256",
        "expected_commit_oid",
        "implementation_digest",
        "fingerprint"
      ],
      "title": "GitCommitSpec",
      "type": "object"
    },
    "GitIndexFileObservation": {
      "additionalProperties": false,
      "description": "U 的物理 Index 观察；与逻辑索引摘要分离，不用于修改或恢复 Index。",
      "properties": {
        "presence": {
          "enum": [
            "absent",
            "file"
          ],
          "title": "Presence",
          "type": "string"
        },
        "identity": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Identity"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sha256"
        },
        "size": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "presence",
        "identity",
        "sha256",
        "size"
      ],
      "title": "GitIndexFileObservation",
      "type": "object"
    },
    "GitInventoryMetrics": {
      "additionalProperties": false,
      "description": "保存唯一对象量与两根逐路径展开量，避免对象去重省略路径预算。",
      "properties": {
        "object_count": {
          "title": "Object Count",
          "type": "integer"
        },
        "unique_body_bytes": {
          "title": "Unique Body Bytes",
          "type": "integer"
        },
        "direct_tree_edges": {
          "title": "Direct Tree Edges",
          "type": "integer"
        },
        "commit_parent_edges": {
          "title": "Commit Parent Edges",
          "type": "integer"
        },
        "base_expanded_entries": {
          "title": "Base Expanded Entries",
          "type": "integer"
        },
        "target_expanded_entries": {
          "title": "Target Expanded Entries",
          "type": "integer"
        },
        "base_tree_depth": {
          "title": "Base Tree Depth",
          "type": "integer"
        },
        "target_tree_depth": {
          "title": "Target Tree Depth",
          "type": "integer"
        }
      },
      "required": [
        "object_count",
        "unique_body_bytes",
        "direct_tree_edges",
        "commit_parent_edges",
        "base_expanded_entries",
        "target_expanded_entries",
        "base_tree_depth",
        "target_tree_depth"
      ],
      "title": "GitInventoryMetrics",
      "type": "object"
    },
    "GitInventoryObject": {
      "additionalProperties": false,
      "description": "以原七字段 CAS 引用保存一个对象及其全部业务角色、直接引用。",
      "properties": {
        "material": {
          "$ref": "#/$defs/GitObjectMaterialReference"
        },
        "roles": {
          "items": {
            "enum": [
              "base_commit",
              "base_tree",
              "target_tree",
              "tree_member",
              "delivery_commit"
            ],
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "tree_entries": {
          "items": {
            "$ref": "#/$defs/GitTreeEntry"
          },
          "title": "Tree Entries",
          "type": "array"
        },
        "commit_references": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitCommitReferences"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "material",
        "roles",
        "tree_entries",
        "commit_references"
      ],
      "title": "GitInventoryObject",
      "type": "object"
    },
    "GitInventoryRoots": {
      "additionalProperties": false,
      "description": "声明完整基线、目标树及可选交付提交的四个类型根。",
      "properties": {
        "base_commit": {
          "$ref": "#/$defs/GitObjectRead"
        },
        "base_tree": {
          "$ref": "#/$defs/GitObjectRead"
        },
        "target_tree": {
          "$ref": "#/$defs/GitObjectRead"
        },
        "delivery_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitObjectRead"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "base_commit",
        "base_tree",
        "target_tree",
        "delivery_commit"
      ],
      "title": "GitInventoryRoots",
      "type": "object"
    },
    "GitInventoryScope": {
      "additionalProperties": false,
      "description": "规划前的完整对象图声明；不包含身份、阶段、批准或认证摘要。",
      "properties": {
        "action_kind": {
          "enum": [
            "checkpoint",
            "commit"
          ],
          "title": "Action Kind",
          "type": "string"
        },
        "platform": {
          "enum": [
            "posix",
            "windows"
          ],
          "title": "Platform",
          "type": "string"
        },
        "roots": {
          "$ref": "#/$defs/GitInventoryRoots"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/GitInventoryObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "external_history": {
          "$ref": "#/$defs/GitBaseHistoryBoundary"
        },
        "limits": {
          "$ref": "#/$defs/GitTreeClosureLimits"
        },
        "max_parents": {
          "title": "Max Parents",
          "type": "integer"
        },
        "metrics": {
          "$ref": "#/$defs/GitInventoryMetrics"
        }
      },
      "required": [
        "action_kind",
        "platform",
        "roots",
        "objects",
        "external_history",
        "limits",
        "max_parents",
        "metrics"
      ],
      "title": "GitInventoryScope",
      "type": "object"
    },
    "GitObjectMaterialReference": {
      "additionalProperties": false,
      "description": "只有对象与完整正文的内容绑定；普通摘要不是原 Owner 或业务认证证明。",
      "properties": {
        "object_type": {
          "enum": [
            "blob",
            "tree",
            "commit"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ],
          "title": "Object Format",
          "type": "string"
        },
        "body_sha256": {
          "title": "Body Sha256",
          "type": "string"
        },
        "body_bytes": {
          "title": "Body Bytes",
          "type": "integer"
        },
        "cas_digest": {
          "title": "Cas Digest",
          "type": "string"
        },
        "version": {
          "const": "harnessix.git-object-material-reference/v1",
          "default": "harnessix.git-object-material-reference/v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_format",
        "body_sha256",
        "body_bytes",
        "cas_digest"
      ],
      "title": "GitObjectMaterialReference",
      "type": "object"
    },
    "GitObjectRead": {
      "additionalProperties": false,
      "description": "明确固定类型、OID和格式；容量不是宿主可调的任意Process预算。",
      "properties": {
        "object_type": {
          "enum": [
            "blob",
            "tree",
            "commit"
          ],
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "object_format": {
          "enum": [
            "sha1",
            "sha256"
          ],
          "title": "Object Format",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "object_format"
      ],
      "title": "GitObjectRead",
      "type": "object"
    },
    "GitTreeClosureLimits": {
      "additionalProperties": false,
      "description": "由受信宿主明确给出的内部验真限额；无产品默认值或额度豁免。",
      "properties": {
        "max_objects": {
          "title": "Max Objects",
          "type": "integer"
        },
        "max_body_bytes": {
          "title": "Max Body Bytes",
          "type": "integer"
        },
        "max_entries": {
          "title": "Max Entries",
          "type": "integer"
        },
        "max_depth": {
          "title": "Max Depth",
          "type": "integer"
        }
      },
      "required": [
        "max_objects",
        "max_body_bytes",
        "max_entries",
        "max_depth"
      ],
      "title": "GitTreeClosureLimits",
      "type": "object"
    },
    "GitTreeEntry": {
      "additionalProperties": false,
      "description": "原始 basename、规范模式与精确子对象请求；名字不进入 repr。",
      "properties": {
        "mode": {
          "enum": [
            "40000",
            "100644",
            "100755",
            "120000",
            "160000"
          ],
          "title": "Mode",
          "type": "string"
        },
        "name": {
          "format": "hex",
          "pattern": "^(?:[0-9a-f]{2})*$",
          "title": "Name",
          "type": "string"
        },
        "child": {
          "$ref": "#/$defs/GitObjectRead"
        }
      },
      "required": [
        "mode",
        "name",
        "child"
      ],
      "title": "GitTreeEntry",
      "type": "object"
    },
    "JsonValue": {},
    "ProductGitDeliveryBaselineV2": {
      "additionalProperties": false,
      "description": "完整Source2绑定固定Git观察；沿用原对象、模式和全字段摘要校验。",
      "properties": {
        "spec_version": {
          "const": "harnessix.product-git-baseline/v2",
          "default": "harnessix.product-git-baseline/v2",
          "title": "Spec Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ProductGitDeliverySourceV2"
        },
        "head_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Head Oid",
          "type": "string"
        },
        "head_tree_oid": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Head Tree Oid",
          "type": "string"
        },
        "head_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Head Ref",
          "type": "string"
        },
        "index_observation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Index Observation Sha256",
          "type": "string"
        },
        "index_observation_bytes": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Index Observation Bytes",
          "type": "integer"
        },
        "status_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Status Sha256",
          "type": "string"
        },
        "config_names_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Names Sha256",
          "type": "string"
        },
        "reader_binding": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reader Binding",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/GitBaselineMember"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "source",
        "head_oid",
        "head_tree_oid",
        "head_ref",
        "index_observation_sha256",
        "index_observation_bytes",
        "status_sha256",
        "config_names_sha256",
        "reader_binding",
        "members",
        "digest"
      ],
      "title": "ProductGitDeliveryBaselineV2",
      "type": "object"
    },
    "ProductGitDeliverySourceV2": {
      "additionalProperties": false,
      "description": "当前全路径观察及完整父引用；不包含Git写入权限或新批准。",
      "properties": {
        "spec_version": {
          "const": "harnessix.product-git-delivery-source/v2",
          "default": "harnessix.product-git-delivery-source/v2",
          "title": "Spec Version",
          "type": "string"
        },
        "thread_id": {
          "format": "uuid",
          "title": "Thread Id",
          "type": "string"
        },
        "patches": {
          "items": {
            "$ref": "#/$defs/WorkspacePatchSourceReference"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Patches",
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceSnapshotV2"
        },
        "mutations": {
          "items": {
            "$ref": "#/$defs/WorkspaceMutation"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Mutations",
          "type": "array"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "patches",
        "workspace",
        "mutations",
        "digest"
      ],
      "title": "ProductGitDeliverySourceV2",
      "type": "object"
    },
    "ProductGitWorktreeIntent": {
      "additionalProperties": false,
      "description": "受信规划冻结的新目录意图；实际父身份及目标不存在仍须原生复核。",
      "properties": {
        "role": {
          "enum": [
            "anchor",
            "delivery"
          ],
          "title": "Role",
          "type": "string"
        },
        "worktree_id": {
