{
  "$defs": {
    "PublicProcessDiagnosticTailV4": {
      "additionalProperties": false,
      "properties": {
        "stdout": {
          "$ref": "#/$defs/PublicProcessStreamTailV4"
        },
        "stderr": {
          "$ref": "#/$defs/PublicProcessStreamTailV4"
        }
      },
      "required": [
        "stdout",
        "stderr"
      ],
      "title": "PublicProcessDiagnosticTailV4",
      "type": "object"
    },
    "PublicProcessStreamSummary": {
      "additionalProperties": false,
      "description": "公开观察摘要；持久流有上限，观察字节数可能因最后一批输出越过上限。",
      "properties": {
        "observed_bytes": {
          "minimum": 0,
          "title": "Observed Bytes",
          "type": "integer"
        },
        "observed_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observed Sha256",
          "type": "string"
        },
        "persisted_bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "title": "Persisted Bytes",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "eof": {
          "title": "Eof",
          "type": "boolean"
        }
      },
      "required": [
        "observed_bytes",
        "observed_sha256",
        "persisted_bytes",
        "truncated",
        "eof"
      ],
      "title": "PublicProcessStreamSummary",
      "type": "object"
    },
    "PublicProcessStreamTailV4": {
      "additionalProperties": false,
      "description": "去除终端转义序列后的UTF-8尾部。\n\n预览覆盖原流从offset到归档末尾的字节，其中removed_escape_bytes字节是被去除的转义序列。",
      "properties": {
        "text": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text"
        },
        "offset": {
          "maximum": 67108864,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "size_bytes": {
          "maximum": 8192,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "removed_escape_bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "title": "Removed Escape Bytes",
          "type": "integer"
        }
      },
      "required": [
        "text",
        "offset",
        "size_bytes",
        "truncated",
        "removed_escape_bytes"
      ],
      "title": "PublicProcessStreamTailV4",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "v3遇到颜色等转义序列即整流不可显示；v4先去除完整转义序列再取尾部。\n\n其他控制字符仍使该流预览为null；其余事实与v3相同。",
  "properties": {
    "version": {
      "const": "trusted-process-output/v4",
      "title": "Version",
      "type": "string"
    },
    "profile": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Profile",
      "type": "string"
    },
    "process_id": {
      "pattern": "^[0-9a-f-]{36}$",
      "title": "Process Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "exited",
        "failed",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "returncode": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Returncode"
    },
    "stop_reason": {
      "enum": [
        "exited",
        "timeout",
        "cancelled",
        "closed",
        "output_limit",
        "input_limit",
        "io_error",
        "host_lost",
        "launch_failed",
        "cleanup_failed",
        "unknown"
      ],
      "title": "Stop Reason",
      "type": "string"
    },
    "stdout": {
      "$ref": "#/$defs/PublicProcessStreamSummary"
    },
    "stderr": {
      "$ref": "#/$defs/PublicProcessStreamSummary"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "diagnostic_preview": {
      "$ref": "#/$defs/PublicProcessDiagnosticTailV4"
    }
  },
  "required": [
    "version",
    "profile",
    "process_id",
    "state",
    "returncode",
    "stop_reason",
    "stdout",
    "stderr",
    "complete",
    "diagnostic_preview"
  ],
  "title": "PublicProcessOutputSummaryV4",
  "type": "object"
}
