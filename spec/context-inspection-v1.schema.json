{
  "$defs": {
    "ContextFragmentDecision": {
      "additionalProperties": false,
      "properties": {
        "fragment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fragment Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ContextFragmentKind"
        },
        "source": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/ContextTrust"
        },
        "priority": {
          "maximum": 600,
          "minimum": 100,
          "title": "Priority",
          "type": "integer"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "estimated_tokens": {
          "minimum": 1,
          "title": "Estimated Tokens",
          "type": "integer"
        },
        "disposition": {
          "enum": [
            "included",
            "omitted_budget"
          ],
          "title": "Disposition",
          "type": "string"
        }
      },
      "required": [
        "fragment_id",
        "kind",
        "source",
        "trust",
        "priority",
        "required",
        "estimated_tokens",
        "disposition"
      ],
      "title": "ContextFragmentDecision",
      "type": "object"
    },
    "ContextFragmentKind": {
      "enum": [
        "runtime_instruction",
        "user_instruction",
        "project_instruction",
        "workspace",
        "git",
        "environment"
      ],
      "title": "ContextFragmentKind",
      "type": "string"
    },
    "ContextLimits": {
      "additionalProperties": false,
      "properties": {
        "context_window_tokens": {
          "maximum": 10000000,
          "minimum": 1024,
          "title": "Context Window Tokens",
          "type": "integer"
        },
        "reserved_output_tokens": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Reserved Output Tokens",
          "type": "integer"
        },
        "provider_overhead_tokens": {
          "default": 512,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Provider Overhead Tokens",
          "type": "integer"
        },
        "safety_margin_tokens": {
          "default": 1024,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Safety Margin Tokens",
          "type": "integer"
        }
      },
      "required": [
        "context_window_tokens",
        "reserved_output_tokens"
      ],
      "title": "ContextLimits",
      "type": "object"
    },
    "ContextTrust": {
      "enum": [
        "runtime",
        "user",
        "project",
        "external"
      ],
      "title": "ContextTrust",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.context-inspection/v1",
      "default": "harnessix.context-inspection/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "model_step": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Model Step",
      "type": "integer"
    },
    "estimator": {
      "const": "utf8-bytes/v1",
      "default": "utf8-bytes/v1",
      "title": "Estimator",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/ContextLimits"
    },
    "available_input_tokens": {
      "minimum": 1,
      "title": "Available Input Tokens",
      "type": "integer"
    },
    "history_tokens": {
      "minimum": 0,
      "title": "History Tokens",
      "type": "integer"
    },
    "tool_tokens": {
      "minimum": 0,
      "title": "Tool Tokens",
      "type": "integer"
    },
    "instruction_tokens": {
      "minimum": 0,
      "title": "Instruction Tokens",
      "type": "integer"
    },
    "estimated_input_tokens": {
      "minimum": 0,
      "title": "Estimated Input Tokens",
      "type": "integer"
    },
    "instruction_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Instruction Fingerprint",
      "type": "string"
    },
    "fragments": {
      "items": {
        "$ref": "#/$defs/ContextFragmentDecision"
      },
      "maxItems": 128,
      "title": "Fragments",
      "type": "array"
    }
  },
  "required": [
    "model_step",
    "limits",
    "available_input_tokens",
    "history_tokens",
    "tool_tokens",
    "instruction_tokens",
    "estimated_input_tokens",
    "instruction_fingerprint"
  ],
  "title": "ContextInspection",
  "type": "object"
}
