{
  "additionalProperties": false,
  "description": "可从唯一字面锚点定位文本页；未指定时仍是原有按行读取。",
  "properties": {
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "start_line": {
      "default": 1,
      "maximum": 2097152,
      "minimum": 1,
      "title": "Start Line",
      "type": "integer"
    },
    "max_lines": {
      "default": 200,
      "maximum": 2000,
      "minimum": 1,
      "title": "Max Lines",
      "type": "integer"
    },
    "expected_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "max_utf8_bytes": {
      "default": 24576,
      "description": "本页文本UTF-8字节上限，不是Token数；整行分页，可用next_line继续",
      "maximum": 24576,
      "minimum": 4096,
      "title": "Max Utf8 Bytes",
      "type": "integer"
    },
    "anchor": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "已知文件中的唯一、大小写敏感单行字面量；不是正则，不猜行号",
      "title": "Anchor"
    },
    "lines_before": {
      "default": 0,
      "maximum": 40,
      "minimum": 0,
      "title": "Lines Before",
      "type": "integer"
    }
  },
  "required": [
    "path"
  ],
  "title": "ReadFileInputV3",
  "type": "object"
}
