{
  "$defs": {
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.action-execution-outcome/v1",
      "default": "harnessix.action-execution-outcome/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "kind": {
      "enum": [
        "succeeded",
        "failed",
        "unknown",
        "manual_intervention"
      ],
      "title": "Kind",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Sha256"
    },
    "external_action_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Action Id"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    }
  },
  "required": [
    "kind"
  ],
  "title": "ActionExecutionOutcome",
  "type": "object"
}
