{
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.hook-dispatch/v1",
      "default": "harnessix.hook-dispatch/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "dispatch_id": {
      "format": "uuid",
      "title": "Dispatch Id",
      "type": "string"
    },
    "event": {
      "enum": [
        "session_started",
        "session_ended",
        "turn_started",
        "turn_completed",
        "before_action",
        "after_action"
      ],
      "title": "Event",
      "type": "string"
    },
    "thread_id": {
      "format": "uuid",
      "title": "Thread Id",
      "type": "string"
    },
    "turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Turn Id"
    },
    "target_action_source": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Action Source"
    },
    "target_action_source_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Action Source Id"
    },
    "target_action_tool": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,255}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Action Tool"
    },
    "target_action_plan_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Action Plan Id"
    },
    "arguments_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arguments Sha256"
    },
    "outcome_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome Sha256"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "dispatch_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dispatch Sha256",
      "type": "string"
    }
  },
  "required": [
    "dispatch_id",
    "event",
    "thread_id",
    "occurred_at",
    "dispatch_sha256"
  ],
  "title": "HookDispatch",
  "type": "object"
}
