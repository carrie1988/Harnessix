{
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.git-repository-binding/v1",
      "default": "harnessix.git-repository-binding/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "platform": {
      "enum": [
        "posix",
        "windows"
      ],
      "title": "Platform",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workspace Id",
      "type": "string"
    },
    "root_path_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Path Sha256",
      "type": "string"
    },
    "root_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Identity",
      "type": "string"
    },
    "common_directory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Common Directory Sha256",
      "type": "string"
    },
    "common_directory_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Common Directory Identity",
      "type": "string"
    },
    "head_oid": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Head Oid",
      "type": "string"
    },
    "head_tree_oid": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Head Tree Oid",
      "type": "string"
    },
    "object_format": {
      "enum": [
        "sha1",
        "sha256"
      ],
      "title": "Object Format",
      "type": "string"
    },
    "status_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Status Sha256",
      "type": "string"
    },
    "config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Sha256",
      "type": "string"
    },
    "git_executable_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Git Executable Identity",
      "type": "string"
    },
    "git_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Git Version",
      "type": "string"
    },
    "implementation_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Implementation Digest",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    }
  },
  "required": [
    "platform",
    "workspace_id",
    "root_path_sha256",
    "root_identity",
    "common_directory_sha256",
    "common_directory_identity",
    "head_oid",
    "head_tree_oid",
    "object_format",
    "status_sha256",
    "config_sha256",
    "git_executable_identity",
    "git_version",
    "implementation_digest",
    "digest"
  ],
  "title": "GitRepositoryBinding",
  "type": "object"
}
