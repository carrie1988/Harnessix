{
  "additionalProperties": false,
  "description": "动态来源的一份瞬时正文；仅其无正文快照进入 Session。",
  "properties": {
    "source": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "content": {
      "maxLength": 262144,
      "title": "Content",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    }
  },
  "required": [
    "source",
    "content",
    "revision"
  ],
  "title": "ContextSourceDocument",
  "type": "object"
}
