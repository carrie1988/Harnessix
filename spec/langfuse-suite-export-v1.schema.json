{
  "$defs": {
    "CodingEvalRate": {
      "additionalProperties": false,
      "description": "以分子、分母和四舍五入基点同时保存可重算比率。",
      "properties": {
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "basis_points"
      ],
      "title": "CodingEvalRate",
      "type": "object"
    },
    "CodingEvalSuiteSummary": {
      "additionalProperties": false,
      "properties": {
        "scheduled_cases": {
          "maximum": 50,
          "minimum": 5,
          "title": "Scheduled Cases",
          "type": "integer"
        },
        "repositories": {
          "maximum": 50,
          "minimum": 2,
          "title": "Repositories",
          "type": "integer"
        },
        "scheduled_trials": {
          "maximum": 1000,
          "minimum": 10,
          "title": "Scheduled Trials",
          "type": "integer"
        },
        "passed_trials": {
          "minimum": 0,
          "title": "Passed Trials",
          "type": "integer"
        },
        "tests_applicable_trials": {
          "minimum": 1,
          "title": "Tests Applicable Trials",
          "type": "integer"
        },
        "tests_passed_trials": {
          "minimum": 0,
          "title": "Tests Passed Trials",
          "type": "integer"
        },
        "human_intervention_trials": {
          "minimum": 0,
          "title": "Human Intervention Trials",
          "type": "integer"
        },
        "task_success_rate": {
          "$ref": "#/$defs/CodingEvalRate"
        },
        "test_pass_rate": {
          "$ref": "#/$defs/CodingEvalRate"
        },
        "human_intervention_rate": {
          "$ref": "#/$defs/CodingEvalRate"
        },
        "model_attempts": {
          "minimum": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_min_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Min Seconds",
          "type": "number"
        },
        "elapsed_p50_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P50 Seconds",
          "type": "number"
        },
        "elapsed_p95_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P95 Seconds",
          "type": "number"
        },
        "elapsed_max_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Max Seconds",
          "type": "number"
        },
        "cost_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Cost Completeness",
          "type": "string"
        },
        "known_cost_currency": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "CNY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Currency"
        },
        "known_cost_amount": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Amount"
        },
        "incomplete_cost_run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Incomplete Cost Run Ids",
          "type": "array"
        }
      },
      "required": [
        "scheduled_cases",
        "repositories",
        "scheduled_trials",
        "passed_trials",
        "tests_applicable_trials",
        "tests_passed_trials",
        "human_intervention_trials",
        "task_success_rate",
        "test_pass_rate",
        "human_intervention_rate",
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "elapsed_min_seconds",
        "elapsed_p50_seconds",
        "elapsed_p95_seconds",
        "elapsed_max_seconds",
        "cost_completeness",
        "incomplete_cost_run_ids"
      ],
      "title": "CodingEvalSuiteSummary",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "完整Suite的脱敏实验投影；原币种成本和未知状态沿用源报告。",
  "properties": {
    "spec_version": {
      "const": "harnessix.langfuse-suite-export/v1",
      "default": "harnessix.langfuse-suite-export/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "suite_id": {
      "format": "uuid",
      "title": "Suite Id",
      "type": "string"
    },
    "source_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Report Sha256",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/CodingEvalSuiteSummary"
    },
    "resource_spans": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Resource Spans",
      "type": "array"
    },
    "scores": {
      "items": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "type": "object"
      },
      "maxItems": 12000,
      "minItems": 1,
      "title": "Scores",
      "type": "array"
    }
  },
  "required": [
    "suite_id",
    "source_report_sha256",
    "summary",
    "resource_spans",
    "scores"
  ],
  "title": "LangfuseSuiteExport",
  "type": "object"
}
