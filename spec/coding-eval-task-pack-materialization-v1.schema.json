{
  "additionalProperties": false,
  "description": "一个Task Pack Case私有工作区的可恢复物化身份。",
  "properties": {
    "spec_version": {
      "const": "harnessix.coding-eval-task-pack-materialization/v1",
      "default": "harnessix.coding-eval-task-pack-materialization/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "pack_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Pack Id",
      "type": "string"
    },
    "pack_version": {
      "minimum": 1,
      "title": "Pack Version",
      "type": "integer"
    },
    "pack_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Pack Sha256",
      "type": "string"
    },
    "case_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Case Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Task Id",
      "type": "string"
    },
    "task_version": {
      "minimum": 1,
      "title": "Task Version",
      "type": "integer"
    },
    "task_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Task Fingerprint",
      "type": "string"
    },
    "repository_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Repository Id",
      "type": "string"
    },
    "source_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Source Revision",
      "type": "string"
    },
    "source_tree_oid": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Source Tree Oid",
      "type": "string"
    },
    "source_archive_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Archive Sha256",
      "type": "string"
    },
    "baseline_revision": {
      "pattern": "^[0-9a-f]{40,64}$",
      "title": "Baseline Revision",
      "type": "string"
    },
    "baseline_tree_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Baseline Tree Sha256",
      "type": "string"
    },
    "tracked_files": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Tracked Files",
      "type": "integer"
    },
    "archive_bytes": {
      "maximum": 67108864,
      "minimum": 1,
      "title": "Archive Bytes",
      "type": "integer"
    },
    "workspace_directory": {
      "const": "workspace",
      "default": "workspace",
      "title": "Workspace Directory",
      "type": "string"
    },
    "status": {
      "const": "ready",
      "default": "ready",
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "pack_id",
    "pack_version",
    "pack_sha256",
    "case_id",
    "task_id",
    "task_version",
    "task_fingerprint",
    "repository_id",
    "source_revision",
    "source_tree_oid",
    "source_archive_sha256",
    "baseline_revision",
    "baseline_tree_sha256",
    "tracked_files",
    "archive_bytes",
    "created_at"
  ],
  "title": "CodingEvalTaskPackMaterialization",
  "type": "object"
}
