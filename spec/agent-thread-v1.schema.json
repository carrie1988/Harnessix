{
  "$defs": {
    "AgentFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "AgentFailure",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 16,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tokens": {
          "default": 100000,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_chars": {
          "default": 65536,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Output Chars",
          "type": "integer"
        },
        "max_tool_calls_per_step": {
          "default": 32,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Tool Calls Per Step",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "EffectClass": {
      "enum": [
        "read_only",
        "idempotent_write",
        "non_idempotent_write",
        "destructive"
      ],
      "title": "EffectClass",
      "type": "string"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "format": "uuid",
          "title": "Item Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        },
        "content": {
          "discriminator": {
            "mapping": {
              "assistant_message": "#/$defs/TextContent",
              "reasoning_summary": "#/$defs/TextContent",
              "tool_call": "#/$defs/ToolCallContent",
              "tool_result": "#/$defs/ToolResultContent",
              "user_message": "#/$defs/TextContent"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextContent"
            },
            {
              "$ref": "#/$defs/ToolCallContent"
            },
            {
              "$ref": "#/$defs/ToolResultContent"
            }
          ],
          "title": "Content"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "item_id",
        "status",
        "content"
      ],
      "title": "Item",
      "type": "object"
    },
    "ItemStatus": {
      "enum": [
        "started",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "JsonValue": {},
    "TextContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "user_message",
            "assistant_message",
            "reasoning_summary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 1000000,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "TextContent",
      "type": "object"
    },
    "ToolCallContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool_call",
          "default": "tool_call",
          "title": "Kind",
          "type": "string"
        },
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "provider_call_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider Call Id",
          "type": "string"
        },
        "tool": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        },
        "effect_class": {
          "$ref": "#/$defs/EffectClass"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "provider_call_id",
        "tool",
        "tool_version",
        "effect_class"
      ],
      "title": "ToolCallContent",
      "type": "object"
    },
    "ToolResultContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "tool_result",
          "default": "tool_result",
          "title": "Kind",
          "type": "string"
        },
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "action_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Id"
        }
      },
      "required": [
        "call_id",
        "outcome"
      ],
      "title": "ToolResultContent",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "description": "跨进程持久化的 W3C Trace Context。",
      "properties": {
        "traceparent": {
          "description": "W3C traceparent",
          "maxLength": 128,
          "minLength": 1,
          "title": "Traceparent",
          "type": "string"
        },
        "tracestate": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "W3C tracestate",
          "title": "Tracestate"
        }
      },
      "required": [
        "traceparent"
      ],
      "title": "TraceContext",
      "type": "object"
    },
    "Turn": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "request_fingerprint": {
          "title": "Request Fingerprint",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TurnStatus",
          "default": "accepted"
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "trace_context": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceContext"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Item"
          },
          "title": "Items",
          "type": "array"
        },
        "model_steps": {
          "default": 0,
          "title": "Model Steps",
          "type": "integer"
        },
        "usage_step": {
          "default": 0,
          "title": "Usage Step",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        }
      },
      "required": [
        "turn_id",
        "request_id",
        "request_fingerprint",
        "budget",
        "created_at"
      ],
      "title": "Turn",
      "type": "object"
    },
    "TurnStatus": {
      "enum": [
        "accepted",
        "preparing_context",
        "calling_model",
        "executing_tools",
        "finalizing",
        "cancelling",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "TurnStatus",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "thread_id": {
      "format": "uuid",
      "title": "Thread Id",
      "type": "string"
    },
    "workspace": {
      "title": "Workspace",
      "type": "string"
    },
    "sequence": {
      "default": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "active_turn_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Turn Id"
    },
    "turns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Turn"
      },
      "title": "Turns",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "workspace",
    "created_at",
    "updated_at"
  ],
  "title": "Thread",
  "type": "object"
}
