{
  "$defs": {
    "ConfigurationDiagnostic": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "config",
            "profile",
            "provider",
            "secret",
            "dependency"
          ],
          "title": "Scope",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Subject Id",
          "type": "string"
        },
        "code": {
          "pattern": "^config_[a-z0-9_]{1,119}$",
          "title": "Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "subject_id",
        "code",
        "status"
      ],
      "title": "ConfigurationDiagnostic",
      "type": "object"
    },
    "ConfigurationDiagnosticReport": {
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "const": "harnessix.configuration-diagnostic/v1",
          "default": "harnessix.configuration-diagnostic/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "selection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Sha256",
          "type": "string"
        },
        "selected_profile": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Selected Profile",
          "type": "string"
        },
        "ready": {
          "title": "Ready",
          "type": "boolean"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ConfigurationDiagnostic"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        }
      },
      "required": [
        "config_sha256",
        "selection_sha256",
        "selected_profile",
        "ready",
        "checks",
        "generated_at",
        "report_sha256"
      ],
      "title": "ConfigurationDiagnosticReport",
      "type": "object"
    },
    "ProductActionCapabilityEvidence": {
      "additionalProperties": false,
      "description": "一次有时效的能力证明或诚实省略事实。",
      "properties": {
        "spec_version": {
          "const": "harnessix.product-action-capability/v1",
          "default": "harnessix.product-action-capability/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "capability_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "artifact",
            "workspace_patch",
            "process_profile"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "omitted"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "platform": {
          "enum": [
            "posix",
            "windows"
          ],
          "title": "Platform",
          "type": "string"
        },
        "binding_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Digest"
        },
        "executor_evidence_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executor Evidence Digest"
        },
        "probed_at": {
          "format": "date-time",
          "title": "Probed At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Sha256",
          "type": "string"
        }
      },
      "required": [
        "capability_id",
        "kind",
        "status",
        "reason_code",
        "platform",
        "probed_at",
        "expires_at",
        "evidence_sha256"
      ],
      "title": "ProductActionCapabilityEvidence",
      "type": "object"
    },
    "ProductActionCapabilityReport": {
      "additionalProperties": false,
      "description": "产品启动时唯一的Action能力广告与省略事实。",
      "properties": {
        "spec_version": {
          "const": "harnessix.product-action-capability-report/v1",
          "default": "harnessix.product-action-capability-report/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ProductActionCapabilityEvidence"
          },
          "maxItems": 64,
          "title": "Capabilities",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        }
      },
      "required": [
        "config_sha256",
        "capabilities",
        "created_at",
        "report_sha256"
      ],
      "title": "ProductActionCapabilityReport",
      "type": "object"
    },
    "ProductPreflightCheck": {
      "additionalProperties": false,
      "description": "一项不含原始异常或宿主路径的产品启动检查。",
      "properties": {
        "check_id": {
          "pattern": "^product_[a-z0-9_]{1,119}$",
          "title": "Check Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "config",
            "profile",
            "dependency",
            "secret",
            "workspace",
            "state",
            "platform",
            "tui",
            "git",
            "action"
          ],
          "title": "Category",
          "type": "string"
        },
        "requirement": {
          "enum": [
            "required",
            "advisory"
          ],
          "title": "Requirement",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z][a-z0-9_]{1,127}$",
          "title": "Code",
          "type": "string"
        },
        "remediation_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{1,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remediation Id"
        },
        "duration_ms": {
          "maximum": 300000,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "check_id",
        "category",
        "requirement",
        "status",
        "code",
        "duration_ms"
      ],
      "title": "ProductPreflightCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Preflight与Doctor共享的版本化、摘要绑定事实。",
  "properties": {
    "spec_version": {
      "const": "harnessix.product-preflight/v1",
      "default": "harnessix.product-preflight/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "mode": {
      "enum": [
        "startup",
        "doctor"
      ],
      "title": "Mode",
      "type": "string"
    },
    "platform": {
      "enum": [
        "posix",
        "windows"
      ],
      "title": "Platform",
      "type": "string"
    },
    "workspace_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workspace Fingerprint",
      "type": "string"
    },
    "config_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Config Sha256"
    },
    "selected_profile": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Profile"
    },
    "configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigurationDiagnosticReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "action_config_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Config Sha256"
    },
    "actions": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductActionCapabilityReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ProductPreflightCheck"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "ready": {
      "title": "Ready",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Report Sha256",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "platform",
    "workspace_fingerprint",
    "checks",
    "ready",
    "generated_at",
    "report_sha256"
  ],
  "title": "ProductPreflightReport",
  "type": "object"
}
