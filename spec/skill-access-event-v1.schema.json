{
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.skill-access-event/v1",
      "default": "harnessix.skill-access-event/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "catalog_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "title": "Catalog Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "operation": {
      "enum": [
        "load",
        "read_resource"
      ],
      "title": "Operation",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "resource_path_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resource Path Sha256"
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "result_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Sha256"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^skill_[a-z0-9_]{1,119}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "previous_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Digest"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    }
  },
  "required": [
    "catalog_id",
    "sequence",
    "generation",
    "catalog_sha256",
    "operation",
    "manifest_sha256",
    "outcome",
    "occurred_at",
    "digest"
  ],
  "title": "SkillAccessEvent",
  "type": "object"
}
