{
  "$defs": {
    "DefinitionHeader": {
      "additionalProperties": false,
      "properties": {
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start_line",
        "end_line",
        "text"
      ],
      "title": "DefinitionHeader",
      "type": "object"
    },
    "DefinitionView": {
      "additionalProperties": false,
      "description": "词法定位的Python定义；正文不拼接声明头或被省略文档。",
      "properties": {
        "spec_version": {
          "const": "harnessix.definition-view/v1",
          "default": "harnessix.definition-view/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "language": {
          "const": "python",
          "default": "python",
          "title": "Language",
          "type": "string"
        },
        "kind": {
          "enum": [
            "function",
            "class"
          ],
          "title": "Kind",
          "type": "string"
        },
        "header": {
          "$ref": "#/$defs/DefinitionHeader"
        },
        "body_start_line": {
          "minimum": 1,
          "title": "Body Start Line",
          "type": "integer"
        },
        "body_end_line": {
          "minimum": 1,
          "title": "Body End Line",
          "type": "integer"
        },
        "omitted_docstring": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLineRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "header",
        "body_start_line",
        "body_end_line"
      ],
      "title": "DefinitionView",
      "type": "object"
    },
    "SourceLineRange": {
      "additionalProperties": false,
      "description": "原始文件中的闭区间；不是执行许可或内容完整性声明。",
      "properties": {
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        }
      },
      "required": [
        "start_line",
        "end_line"
      ],
      "title": "SourceLineRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "保持连续原文页与原始SHA，新增定义视图元数据；不伪造完整源码。",
  "properties": {
    "path": {
      "title": "Path",
      "type": "string"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "start_line": {
      "minimum": 1,
      "title": "Start Line",
      "type": "integer"
    },
    "end_line": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "End Line"
    },
    "utf8_bytes": {
      "maximum": 24576,
      "minimum": 0,
      "title": "Utf8 Bytes",
      "type": "integer"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "truncated": {
      "title": "Truncated",
      "type": "boolean"
    },
    "truncation_reason": {
      "anyOf": [
        {
          "enum": [
            "line_limit",
            "byte_limit"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Truncation Reason"
    },
    "next_line": {
      "anyOf": [
        {
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Line"
    },
    "spec_version": {
      "const": "harnessix.read-file-snapshot/v1",
      "default": "harnessix.read-file-snapshot/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "file_bytes": {
      "description": "完整原始文件字节数，不是可见文本页字节数",
      "minimum": 0,
      "title": "File Bytes",
      "type": "integer"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "完整原始文件SHA-256；超限时为null",
      "title": "Content Sha256"
    },
    "digest_status": {
      "description": "完整摘要状态，与文本页是否截断相互独立",
      "enum": [
        "complete",
        "omitted_limit"
      ],
      "title": "Digest Status",
      "type": "string"
    },
    "definition": {
      "anyOf": [
        {
          "$ref": "#/$defs/DefinitionView"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "path",
    "text",
    "start_line",
    "end_line",
    "utf8_bytes",
    "revision",
    "truncated",
    "truncation_reason",
    "next_line",
    "file_bytes",
    "content_sha256",
    "digest_status"
  ],
  "title": "ReadFileViewOutput",
  "type": "object"
}
