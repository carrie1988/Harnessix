{
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.skill-manifest-snapshot/v1",
      "default": "harnessix.skill-manifest-snapshot/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_kind": {
      "enum": [
        "bundled",
        "user",
        "workspace"
      ],
      "title": "Source Kind",
      "type": "string"
    },
    "name": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Name",
      "type": "string"
    },
    "qualified_name": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Qualified Name",
      "type": "string"
    },
    "description": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "declared_version": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Declared Version"
    },
    "effective_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Effective Version",
      "type": "string"
    },
    "relative_path": {
      "maxLength": 4096,
      "minLength": 8,
      "title": "Relative Path",
      "type": "string"
    },
    "content_utf8_bytes": {
      "maximum": 262144,
      "minimum": 1,
      "title": "Content Utf8 Bytes",
      "type": "integer"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "metadata_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Metadata Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "source_kind",
    "name",
    "qualified_name",
    "description",
    "effective_version",
    "relative_path",
    "content_utf8_bytes",
    "content_sha256",
    "metadata_sha256",
    "manifest_sha256"
  ],
  "title": "SkillManifestSnapshot",
  "type": "object"
}
