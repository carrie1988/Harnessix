{
  "$defs": {
    "WorkspaceDiffEntryV2": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "added",
            "modified",
            "deleted",
            "renamed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "original_path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Path"
        },
        "before": {
          "$ref": "#/$defs/WorkspaceFileVersionV2"
        },
        "after": {
          "$ref": "#/$defs/WorkspaceFileVersionV2"
        },
        "binary": {
          "title": "Binary",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "path",
        "before",
        "after",
        "binary"
      ],
      "title": "WorkspaceDiffEntryV2",
      "type": "object"
    },
    "WorkspaceFileVersionV2": {
      "additionalProperties": false,
      "description": "文件版本的完整性规则沿用原合同，只把权限放宽为真实的普通权限位。",
      "properties": {
        "presence": {
          "enum": [
            "absent",
            "file"
          ],
          "title": "Presence",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size": {
          "maximum": 8388608,
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        },
        "mode": {
          "anyOf": [
            {
              "maximum": 511,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        }
      },
      "required": [
        "presence",
        "size"
      ],
      "title": "WorkspaceFileVersionV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.workspace-diff/v2",
      "default": "harnessix.workspace-diff/v2",
      "title": "Spec Version",
      "type": "string"
    },
    "transaction_id": {
      "format": "uuid",
      "title": "Transaction Id",
      "type": "string"
    },
    "plan_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/WorkspaceDiffEntryV2"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Entries",
      "type": "array"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "utf8_bytes": {
      "maximum": 67108864,
      "minimum": 1,
      "title": "Utf8 Bytes",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "plan_fingerprint",
    "entries",
    "text",
    "utf8_bytes",
    "sha256"
  ],
  "title": "WorkspaceDiffDocumentV2",
  "type": "object"
}
