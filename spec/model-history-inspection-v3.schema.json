{
  "$defs": {
    "ToolResultViewPolicy": {
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "const": "harnessix.tool-result-model-view/v1",
          "default": "harnessix.tool-result-model-view/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "max_inline_utf8_bytes": {
          "default": 65536,
          "maximum": 1000000,
          "minimum": 1024,
          "title": "Max Inline Utf8 Bytes",
          "type": "integer"
        }
      },
      "title": "ToolResultViewPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "工作集视图：v1字段描述按决定准备的基础视图，view摘要绑定遮蔽后实际模型历史。\n\n只保留最近若干工具调用组的结果正文；更早结果的输出换成固定占位，Native事实不变。",
  "properties": {
    "spec_version": {
      "const": "harnessix.model-history-inspection/v3",
      "default": "harnessix.model-history-inspection/v3",
      "title": "Spec Version",
      "type": "string"
    },
    "model_step": {
      "maximum": 1000,
      "minimum": 1,
      "title": "Model Step",
      "type": "integer"
    },
    "policy": {
      "$ref": "#/$defs/ToolResultViewPolicy"
    },
    "history_items": {
      "maximum": 8192,
      "minimum": 1,
      "title": "History Items",
      "type": "integer"
    },
    "tool_results": {
      "maximum": 8192,
      "minimum": 0,
      "title": "Tool Results",
      "type": "integer"
    },
    "inline_results": {
      "maximum": 8192,
      "minimum": 0,
      "title": "Inline Results",
      "type": "integer"
    },
    "artifact_reference_results": {
      "maximum": 8192,
      "minimum": 0,
      "title": "Artifact Reference Results",
      "type": "integer"
    },
    "artifact_bindings": {
      "maximum": 16384,
      "minimum": 0,
      "title": "Artifact Bindings",
      "type": "integer"
    },
    "source_tool_result_utf8_bytes": {
      "maximum": 8388608,
      "minimum": 0,
      "title": "Source Tool Result Utf8 Bytes",
      "type": "integer"
    },
    "view_tool_result_utf8_bytes": {
      "maximum": 8388608,
      "minimum": 0,
      "title": "View Tool Result Utf8 Bytes",
      "type": "integer"
    },
    "source_history_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source History Sha256",
      "type": "string"
    },
    "view_history_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "View History Sha256",
      "type": "string"
    },
    "decisions_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Decisions Sha256",
      "type": "string"
    },
    "retain_recent_result_groups": {
      "maximum": 64,
      "minimum": 1,
      "title": "Retain Recent Result Groups",
      "type": "integer"
    },
    "stale_results": {
      "maximum": 8192,
      "minimum": 0,
      "title": "Stale Results",
      "type": "integer"
    }
  },
  "required": [
    "model_step",
    "policy",
    "history_items",
    "tool_results",
    "inline_results",
    "artifact_reference_results",
    "artifact_bindings",
    "source_tool_result_utf8_bytes",
    "view_tool_result_utf8_bytes",
    "source_history_sha256",
    "view_history_sha256",
    "decisions_sha256",
    "retain_recent_result_groups",
    "stale_results"
  ],
  "title": "ModelHistoryInspectionV3",
  "type": "object"
}
