    "/v1/actions": {
      "post": {
        "tags": [
          "Action"
        ],
        "summary": "Submit Action",
        "operationId": "submit_action_v1_actions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ActionRequest"
              }
