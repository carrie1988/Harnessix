{
  "$defs": {
    "BillingContext": {
      "additionalProperties": false,
      "description": "可信宿主核对的计费上下文；不是从 Adapter 类型或请求模型猜测。",
      "properties": {
        "billing_provider": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Provider"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "service_tier": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "inference_mode": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Mode"
        },
        "cache_write_ttl": {
          "anyOf": [
            {
              "enum": [
                "5m",
                "1h"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Ttl"
        }
      },
      "title": "BillingContext",
      "type": "object"
    },
    "CodingEvalCampaignPlan": {
      "additionalProperties": false,
      "description": "在任何真实请求前固定的可比较试验集合与计价上下文。",
      "properties": {
        "spec_version": {
          "const": "harnessix.coding-eval-campaign-plan/v1",
          "default": "harnessix.coding-eval-campaign-plan/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "campaign_id": {
          "format": "uuid",
          "title": "Campaign Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "minimum": 1,
          "title": "Task Version",
          "type": "integer"
        },
        "task_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Fingerprint",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/CodingEvalEnvironment"
        },
        "run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Run Ids",
          "type": "array"
        },
        "price": {
          "$ref": "#/$defs/PriceSnapshot"
        },
        "billing_context": {
          "$ref": "#/$defs/BillingContext"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "campaign_id",
        "task_id",
        "task_version",
        "task_fingerprint",
        "environment",
        "run_ids",
        "price",
        "billing_context",
        "created_at"
      ],
      "title": "CodingEvalCampaignPlan",
      "type": "object"
    },
    "CodingEvalCampaignSummary": {
      "additionalProperties": false,
      "properties": {
        "scheduled_trials": {
          "maximum": 20,
          "minimum": 2,
          "title": "Scheduled Trials",
          "type": "integer"
        },
        "passed_trials": {
          "minimum": 0,
          "title": "Passed Trials",
          "type": "integer"
        },
        "provider_failed_trials": {
          "minimum": 0,
          "title": "Provider Failed Trials",
          "type": "integer"
        },
        "eval_infrastructure_failed_trials": {
          "minimum": 0,
          "title": "Eval Infrastructure Failed Trials",
          "type": "integer"
        },
        "runtime_failed_trials": {
          "minimum": 0,
          "title": "Runtime Failed Trials",
          "type": "integer"
        },
        "task_failed_trials": {
          "minimum": 0,
          "title": "Task Failed Trials",
          "type": "integer"
        },
        "budget_failed_trials": {
          "minimum": 0,
          "title": "Budget Failed Trials",
          "type": "integer"
        },
        "model_attempts": {
          "minimum": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_min_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Min Seconds",
          "type": "number"
        },
        "elapsed_p50_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P50 Seconds",
          "type": "number"
        },
        "elapsed_p95_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P95 Seconds",
          "type": "number"
        },
        "elapsed_max_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Max Seconds",
          "type": "number"
        },
        "cost_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Cost Completeness",
          "type": "string"
        },
        "known_cost_currency": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "CNY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Currency"
        },
        "known_cost_amount": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Amount"
        },
        "incomplete_cost_run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Incomplete Cost Run Ids",
          "type": "array"
        }
      },
      "required": [
        "scheduled_trials",
        "passed_trials",
        "provider_failed_trials",
        "eval_infrastructure_failed_trials",
        "runtime_failed_trials",
        "task_failed_trials",
        "budget_failed_trials",
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "elapsed_min_seconds",
        "elapsed_p50_seconds",
        "elapsed_p95_seconds",
        "elapsed_max_seconds",
        "cost_completeness",
        "incomplete_cost_run_ids"
      ],
      "title": "CodingEvalCampaignSummary",
      "type": "object"
    },
    "CodingEvalCampaignTrial": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "eval_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Eval Report Sha256",
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "turn_status": {
          "$ref": "#/$defs/TurnStatus"
        },
        "classification": {
          "enum": [
            "passed",
            "provider",
            "eval_infrastructure",
            "runtime",
            "task",
            "budget"
          ],
          "title": "Classification",
          "type": "string"
        },
        "eval_outcome": {
          "enum": [
            "passed",
            "failed",
            "invalid"
          ],
          "title": "Eval Outcome",
          "type": "string"
        },
        "failure_categories": {
          "items": {
            "enum": [
              "eval_infrastructure",
              "runtime",
              "correctness",
              "regression",
              "forbidden_edit",
              "final_answer",
              "budget"
            ],
            "type": "string"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "agent_failure_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureCategory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseFailed"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_models": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:/-]+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Actual Models",
          "type": "array"
        },
        "model_attempts": {
          "maximum": 32000,
          "minimum": 1,
          "title": "Model Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "cost_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Cost Completeness",
          "type": "string"
        },
        "known_cost_currency": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "CNY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Currency"
        },
        "known_cost_amount": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Amount"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "eval_report_sha256",
        "turn_id",
        "turn_status",
        "classification",
        "eval_outcome",
        "failure_categories",
        "actual_models",
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "elapsed_seconds",
        "cost_completeness",
        "started_at",
        "completed_at"
      ],
      "title": "CodingEvalCampaignTrial",
      "type": "object"
    },
    "CodingEvalEnvironment": {
      "additionalProperties": false,
      "properties": {
        "harnessix_revision": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Harnessix Revision",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "platform": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "isolation": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Isolation",
          "type": "string"
        }
      },
      "required": [
        "harnessix_revision",
        "provider",
        "model",
        "platform",
        "isolation"
      ],
      "title": "CodingEvalEnvironment",
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "input",
        "provider",
        "tool",
        "approval",
        "budget",
        "cancelled",
        "interrupted",
        "storage",
        "conflict",
        "internal"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "FlatInputPrice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "flat",
          "default": "flat",
          "title": "Kind",
          "type": "string"
        },
        "per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Per Million",
          "type": "string"
        }
      },
      "required": [
        "per_million"
      ],
      "title": "FlatInputPrice",
      "type": "object"
    },
    "PartitionedInputPrice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "partitioned",
          "default": "partitioned",
          "title": "Kind",
          "type": "string"
        },
        "uncached_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Uncached Per Million",
          "type": "string"
        },
        "cache_read_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Cache Read Per Million",
          "type": "string"
        },
        "cache_creation_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Cache Creation Per Million",
          "type": "string"
        },
        "cache_write_ttl": {
          "anyOf": [
            {
              "enum": [
                "5m",
                "1h"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Write Ttl"
        }
      },
      "required": [
        "uncached_per_million",
        "cache_read_per_million",
        "cache_creation_per_million",
        "cache_write_ttl"
      ],
      "title": "PartitionedInputPrice",
      "type": "object"
    },
    "PriceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "const": "harnessix.price/v1",
          "default": "harnessix.price/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Version",
          "type": "string"
        },
        "source_url": {
          "maxLength": 2048,
          "title": "Source Url",
          "type": "string"
        },
        "billing_provider": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Billing Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Model",
          "type": "string"
        },
        "region": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Region",
          "type": "string"
        },
        "service_tier": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Service Tier",
          "type": "string"
        },
        "inference_mode": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Inference Mode",
          "type": "string"
        },
        "currency": {
          "enum": [
            "USD",
            "CNY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "input_tokens_min": {
          "minimum": 0,
          "title": "Input Tokens Min",
          "type": "integer"
        },
        "input_tokens_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens Max"
        },
        "input_price": {
          "discriminator": {
            "mapping": {
              "flat": "#/$defs/FlatInputPrice",
              "partitioned": "#/$defs/PartitionedInputPrice"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FlatInputPrice"
            },
            {
              "$ref": "#/$defs/PartitionedInputPrice"
            }
          ],
          "title": "Input Price"
        },
        "output_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Output Per Million",
          "type": "string"
        }
      },
      "required": [
        "version",
        "source_url",
        "billing_provider",
        "model",
        "region",
        "service_tier",
        "inference_mode",
        "currency",
        "valid_from",
        "valid_until",
        "input_tokens_min",
        "input_tokens_max",
        "input_price",
        "output_per_million"
      ],
      "title": "PriceSnapshot",
      "type": "object"
    },
    "ResponseFailed": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "response_failed",
          "default": "response_failed",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "enum": [
            "invalid_request",
            "authentication",
            "rate_limit",
            "quota",
            "content_policy",
            "provider_internal",
            "transport",
            "invalid_provider_output",
            "context_overflow",
            "cancelled",
            "unknown"
          ],
          "title": "Code",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code"
      ],
      "title": "ResponseFailed",
      "type": "object"
    },
    "TurnStatus": {
      "enum": [
        "accepted",
        "preparing_context",
        "calling_model",
        "executing_tools",
        "waiting_approval",
        "waiting_action",
        "finalizing",
        "cancelling",
        "completed",
        "failed",
        "cancelled",
        "interrupted"
      ],
      "title": "TurnStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.coding-eval-campaign-report/v1",
      "default": "harnessix.coding-eval-campaign-report/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/CodingEvalCampaignPlan"
    },
    "plan_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/CodingEvalCampaignTrial"
      },
      "maxItems": 20,
      "minItems": 2,
      "title": "Trials",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/CodingEvalCampaignSummary"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "plan",
    "plan_fingerprint",
    "trials",
    "summary",
    "completed_at"
  ],
  "title": "CodingEvalCampaignReport",
  "type": "object"
}
