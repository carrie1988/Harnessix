{
  "$defs": {
    "ProcessOutputObservation": {
      "additionalProperties": false,
      "properties": {
        "observed_bytes": {
          "minimum": 0,
          "title": "Observed Bytes",
          "type": "integer"
        },
        "persisted_bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "title": "Persisted Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "persisted_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Persisted Sha256",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "eof": {
          "title": "Eof",
          "type": "boolean"
        }
      },
      "required": [
        "observed_bytes",
        "persisted_bytes",
        "sha256",
        "persisted_sha256",
        "truncated",
        "eof"
      ],
      "title": "ProcessOutputObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.process-owner-receipt/v1",
      "default": "harnessix.process-owner-receipt/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "process_id": {
      "format": "uuid",
      "title": "Process Id",
      "type": "string"
    },
    "owner_identity": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Owner Identity",
      "type": "string"
    },
    "state": {
      "enum": [
        "running",
        "exited",
        "failed",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "pid": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pid"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "returncode": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": -2147483648,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Returncode"
    },
    "stop_reason": {
      "anyOf": [
        {
          "enum": [
            "exited",
            "timeout",
            "cancelled",
            "closed",
            "output_limit",
            "input_limit",
            "io_error",
            "host_lost",
            "launch_failed",
            "cleanup_failed",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Reason"
    },
    "stdout": {
      "$ref": "#/$defs/ProcessOutputObservation"
    },
    "stderr": {
      "$ref": "#/$defs/ProcessOutputObservation"
    },
    "mac": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Mac",
      "type": "string"
    }
  },
  "required": [
    "process_id",
    "owner_identity",
    "state",
    "sequence",
    "stdout",
    "stderr",
    "mac"
  ],
  "title": "ProcessOwnerReceipt",
  "type": "object"
}
