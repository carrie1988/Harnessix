{
  "$defs": {
    "ApprovalRespondParams": {
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Requestid",
          "type": "string"
        },
        "threadId": {
          "format": "uuid",
          "title": "Threadid",
          "type": "string"
        },
        "turnId": {
          "format": "uuid",
          "title": "Turnid",
          "type": "string"
        },
        "approvalId": {
          "format": "uuid",
          "title": "Approvalid",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/PublicApprovalDecision"
        }
      },
      "required": [
        "requestId",
        "threadId",
        "turnId",
        "approvalId",
        "fingerprint",
        "decision"
      ],
      "title": "ApprovalRespondParams",
      "type": "object"
    },
    "PublicApprovalDecision": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "approved",
            "rejected"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "actor": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "outcome",
        "actor"
      ],
      "title": "PublicApprovalDecision",
      "type": "object"
    },
    "PublicBudget": {
      "additionalProperties": false,
      "properties": {
        "maxSteps": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Maxsteps",
          "type": "integer"
        },
        "maxTokens": {
          "minimum": 1,
          "title": "Maxtokens",
          "type": "integer"
        },
        "timeoutSeconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeoutseconds",
          "type": "number"
        },
        "maxOutputChars": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Maxoutputchars",
          "type": "integer"
        },
        "maxToolCallsPerStep": {
          "maximum": 128,
          "minimum": 1,
          "title": "Maxtoolcallsperstep",
          "type": "integer"
        }
      },
      "required": [
        "maxSteps",
        "maxTokens",
        "timeoutSeconds",
        "maxOutputChars",
        "maxToolCallsPerStep"
      ],
      "title": "PublicBudget",
      "type": "object"
