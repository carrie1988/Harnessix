    "ModelAttempt": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "step": {
          "minimum": 1,
          "title": "Step",
          "type": "integer"
        },
        "index": {
          "maximum": 32,
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "provider": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Provider",
          "type": "string"
        },
        "requested_model": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:/-]+$",
          "title": "Requested Model",
          "type": "string"
        },
        "actual_model": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Model"
        },
        "response_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        },
        "usage": {
          "$ref": "#/$defs/UsageObservation"
        },
        "billing": {
          "$ref": "#/$defs/ResponseBillingMetadata"
        },
        "status": {
          "default": "running",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "title": "Status",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        }
      },
      "required": [
        "attempt_id",
        "step",
        "index",
        "provider",
        "requested_model",
        "started_at"
      ],
      "title": "ModelAttempt",
      "type": "object"
