{
  "$defs": {
    "AgentFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "category": {
          "$ref": "#/$defs/FailureCategory",
          "default": "internal"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "AgentFailure",
      "type": "object"
    },
    "ApprovalOutcome": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "ApprovalOutcome",
      "type": "string"
    },
    "ApprovalRecord": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/ApprovalOutcome"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "request_fingerprint": {
          "title": "Request Fingerprint",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "actor",
        "request_fingerprint"
      ],
      "title": "ApprovalRecord",
      "type": "object"
    },
    "ApprovalRequestContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "approval_request",
          "default": "approval_request",
          "title": "Kind",
          "type": "string"
        },
        "approval_id": {
          "format": "uuid",
          "title": "Approval Id",
          "type": "string"
        },
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "request_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Fingerprint",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "policy_version": {
          "const": "kernel-read-only/v1",
          "default": "kernel-read-only/v1",
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "call_id",
        "request_fingerprint"
      ],
      "title": "ApprovalRequestContent",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "format": "uuid",
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "records": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Records",
          "type": "integer"
        },
        "format": {
          "const": "jsonl/v1",
          "default": "jsonl/v1",
          "title": "Format",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "size_bytes",
        "records",
        "complete",
        "expires_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BatchExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "managed-patch-batch-result/v1",
          "default": "managed-patch-batch-result/v1",
          "title": "Version",
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/BatchRunRecord"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/BatchMemberEffect"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "effect": {
          "enum": [
            "not_applied",
            "applied",
            "partial",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "run",
        "members",
        "effect"
      ],
      "title": "BatchExecutionResult",
      "type": "object"
    },
    "BatchMemberEffect": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "started",
            "applied",
            "failed",
            "uncertain",
            "observed_before",
            "observed_after",
            "diverged",
            "missing",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "effect": {
          "enum": [
            "not_applied",
            "applied",
            "unknown"
          ],
          "title": "Effect",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "plan_id",
        "state",
        "effect"
      ],
      "title": "BatchMemberEffect",
      "type": "object"
    },
    "BatchRunRecord": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "managed-patch-batch-run/v1",
          "default": "managed-patch-batch-run/v1",
          "title": "Version",
          "type": "string"
        },
        "batch_id": {
          "format": "uuid",
          "title": "Batch Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "approval_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Fingerprint",
          "type": "string"
        },
        "phase": {
          "enum": [
            "started",
            "finished"
          ],
          "title": "Phase",
          "type": "string"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "cancelled",
                "timeout",
                "failed",
                "interrupted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-z0-9_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "batch_id",
        "workspace_id",
        "approval_fingerprint",
        "phase"
      ],
      "title": "BatchRunRecord",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 16,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tokens": {
          "default": 100000,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 120,
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "max_output_chars": {
          "default": 65536,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Output Chars",
          "type": "integer"
        },
        "max_tool_calls_per_step": {
          "default": 32,
          "maximum": 128,
          "minimum": 1,
          "title": "Max Tool Calls Per Step",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "CompactionContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "context_compaction",
          "default": "context_compaction",
          "title": "Kind",
          "type": "string"
        },
        "source_item_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Source Item Ids",
          "type": "array"
        },
        "summary": {
          "maxLength": 1000000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tokens_before": {
          "minimum": 1,
          "title": "Tokens Before",
          "type": "integer"
        },
        "tokens_after": {
          "minimum": 0,
          "title": "Tokens After",
          "type": "integer"
        },
        "tokenizer": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Tokenizer",
          "type": "string"
        }
      },
      "required": [
        "source_item_ids",
        "summary",
        "tokens_before",
        "tokens_after",
        "tokenizer"
      ],
      "title": "CompactionContent",
      "type": "object"
    },
    "EffectClass": {
      "enum": [
        "read_only",
        "idempotent_write",
        "non_idempotent_write",
        "destructive"
      ],
      "title": "EffectClass",
      "type": "string"
    },
    "ErrorContent": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "error",
          "default": "error",
          "title": "Kind",
          "type": "string"
        },
        "failure": {
          "$ref": "#/$defs/AgentFailure"
        }
      },
      "required": [
        "failure"
      ],
      "title": "ErrorContent",
      "type": "object"
    },
    "FailureCategory": {
      "enum": [
        "input",
        "provider",
        "tool",
        "approval",
        "budget",
        "cancelled",
        "interrupted",
        "storage",
        "conflict",
        "internal"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "Item": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "format": "uuid",
          "title": "Item Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ItemStatus"
        },
        "content": {
          "discriminator": {
            "mapping": {
              "approval_request": "#/$defs/ApprovalRequestContent",
              "assistant_message": "#/$defs/TextContent",
              "context_compaction": "#/$defs/CompactionContent",
              "error": "#/$defs/ErrorContent",
              "patch_approval_request": "#/$defs/PatchApprovalRequestContent",
              "patch_batch_approval_request": "#/$defs/PatchBatchApprovalRequestContent",
              "plan": "#/$defs/PlanContent",
              "reasoning_summary": "#/$defs/TextContent",
              "tool_call": "#/$defs/ToolCallContent",
              "tool_result": "#/$defs/ToolResultContent",
              "user_message": "#/$defs/TextContent"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextContent"
            },
            {
              "$ref": "#/$defs/ToolCallContent"
            },
            {
              "$ref": "#/$defs/ToolResultContent"
            },
            {
              "$ref": "#/$defs/ApprovalRequestContent"
            },
            {
              "$ref": "#/$defs/PatchApprovalRequestContent"
            },
            {
              "$ref": "#/$defs/PatchBatchApprovalRequestContent"
            },
            {
              "$ref": "#/$defs/PlanContent"
            },
            {
              "$ref": "#/$defs/CompactionContent"
            },
            {
              "$ref": "#/$defs/ErrorContent"
            }
          ],
          "title": "Content"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentFailure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "item_id",
        "status",
        "content"
      ],
      "title": "Item",
      "type": "object"
    },
    "ItemStatus": {
      "enum": [
        "started",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "ItemStatus",
      "type": "string"
    },
    "JsonValue": {},
