{
  "additionalProperties": false,
  "description": "显式Python定义视图；text默认保持原有分页，不猜测语言或执行源码。",
  "properties": {
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "start_line": {
      "default": 1,
      "maximum": 2097152,
      "minimum": 1,
      "title": "Start Line",
      "type": "integer"
    },
    "max_lines": {
      "default": 200,
      "maximum": 2000,
      "minimum": 1,
      "title": "Max Lines",
      "type": "integer"
    },
    "expected_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "max_utf8_bytes": {
      "default": 24576,
      "description": "本页文本UTF-8字节上限，不是Token数；整行分页，可用next_line继续",
      "maximum": 24576,
      "minimum": 4096,
      "title": "Max Utf8 Bytes",
      "type": "integer"
    },
    "anchor": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "已知文件中的唯一、大小写敏感单行字面量；不是正则，不猜行号",
      "title": "Anchor"
    },
    "lines_before": {
      "default": 0,
      "maximum": 40,
      "minimum": 0,
      "title": "Lines Before",
      "type": "integer"
    },
    "view": {
      "default": "text",
      "description": "definition用于有界Python文件：返回真实声明头和实现页，显式标注省略的前导文档",
      "enum": [
        "text",
        "definition"
      ],
      "title": "View",
      "type": "string"
    }
  },
  "required": [
    "path"
  ],
  "title": "ReadFileInputV4",
  "type": "object"
}
