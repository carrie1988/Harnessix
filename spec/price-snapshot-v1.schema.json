{
  "$defs": {
    "FlatInputPrice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "flat",
          "default": "flat",
          "title": "Kind",
          "type": "string"
        },
        "per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Per Million",
          "type": "string"
        }
      },
      "required": [
        "per_million"
      ],
      "title": "FlatInputPrice",
      "type": "object"
    },
    "PartitionedInputPrice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "partitioned",
          "default": "partitioned",
          "title": "Kind",
          "type": "string"
        },
        "uncached_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Uncached Per Million",
          "type": "string"
        },
        "cache_read_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Cache Read Per Million",
          "type": "string"
        },
        "cache_creation_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Cache Creation Per Million",
          "type": "string"
        },
        "cache_write_ttl": {
          "anyOf": [
            {
              "enum": [
                "5m",
                "1h"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cache Write Ttl"
        }
      },
      "required": [
        "uncached_per_million",
        "cache_read_per_million",
        "cache_creation_per_million",
        "cache_write_ttl"
      ],
      "title": "PartitionedInputPrice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.price/v1",
      "default": "harnessix.price/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/-]+$",
      "title": "Version",
      "type": "string"
    },
    "source_url": {
      "maxLength": 2048,
      "title": "Source Url",
      "type": "string"
    },
    "billing_provider": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/-]+$",
      "title": "Billing Provider",
      "type": "string"
    },
    "model": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/-]+$",
      "title": "Model",
      "type": "string"
    },
    "region": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/-]+$",
      "title": "Region",
      "type": "string"
    },
    "service_tier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/-]+$",
      "title": "Service Tier",
      "type": "string"
    },
    "inference_mode": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:/-]+$",
      "title": "Inference Mode",
      "type": "string"
    },
    "currency": {
      "enum": [
        "USD",
        "CNY"
      ],
      "title": "Currency",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    },
    "input_tokens_min": {
      "minimum": 0,
      "title": "Input Tokens Min",
      "type": "integer"
    },
    "input_tokens_max": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Input Tokens Max"
    },
    "input_price": {
      "discriminator": {
        "mapping": {
          "flat": "#/$defs/FlatInputPrice",
          "partitioned": "#/$defs/PartitionedInputPrice"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FlatInputPrice"
        },
        {
          "$ref": "#/$defs/PartitionedInputPrice"
        }
      ],
      "title": "Input Price"
    },
    "output_per_million": {
      "maxLength": 25,
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
      "title": "Output Per Million",
      "type": "string"
    }
  },
  "required": [
    "version",
    "source_url",
    "billing_provider",
    "model",
    "region",
    "service_tier",
    "inference_mode",
    "currency",
    "valid_from",
    "valid_until",
    "input_tokens_min",
    "input_tokens_max",
    "input_price",
    "output_per_million"
  ],
  "title": "PriceSnapshot",
  "type": "object"
}
