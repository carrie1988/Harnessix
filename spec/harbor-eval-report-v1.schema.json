{
  "$defs": {
    "CodingEvalRate": {
      "additionalProperties": false,
      "description": "以分子、分母和四舍五入基点同时保存可重算比率。",
      "properties": {
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "basis_points"
      ],
      "title": "CodingEvalRate",
      "type": "object"
    },
    "HarborEvalSummary": {
      "additionalProperties": false,
      "description": "覆盖冻结计划全部槽位的可重算汇总；不丢弃异常和缺失结果。",
      "properties": {
        "scheduled_trials": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Scheduled Trials",
          "type": "integer"
        },
        "passed_trials": {
          "minimum": 0,
          "title": "Passed Trials",
          "type": "integer"
        },
        "failed_trials": {
          "minimum": 0,
          "title": "Failed Trials",
          "type": "integer"
        },
        "invalid_trials": {
          "minimum": 0,
          "title": "Invalid Trials",
          "type": "integer"
        },
        "pass_rate": {
          "$ref": "#/$defs/CodingEvalRate"
        },
        "cost_completeness": {
          "const": "unknown",
          "default": "unknown",
          "title": "Cost Completeness",
          "type": "string"
        }
      },
      "required": [
        "scheduled_trials",
        "passed_trials",
        "failed_trials",
        "invalid_trials",
        "pass_rate"
      ],
      "title": "HarborEvalSummary",
      "type": "object"
    },
    "HarborEvalTrial": {
      "additionalProperties": false,
      "description": "冻结计划中的一个槽位；缺失结果也保留，观测用量不代表完整账单。",
      "properties": {
        "slot": {
          "maximum": 999,
          "minimum": 0,
          "title": "Slot",
          "type": "integer"
        },
        "slot_id": {
          "description": "由Job和冻结槽位派生的关联ID，不表示已执行的Harbor试次或原生Turn。",
          "format": "uuid",
          "title": "Slot Id",
          "type": "string"
        },
        "task_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task Name",
          "type": "string"
        },
        "task_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Task Digest",
          "type": "string"
        },
        "input_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Lock Sha256",
          "type": "string"
        },
        "harbor_trial_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harbor Trial Id"
        },
        "source_result_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Result Sha256"
        },
        "thread_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "turn_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "outcome": {
          "enum": [
            "passed",
            "failed",
            "invalid"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "classification": {
          "enum": [
            "passed",
            "provider",
            "eval_infrastructure",
            "runtime",
            "task",
            "budget"
          ],
          "title": "Classification",
          "type": "string"
        },
        "reason": {
          "enum": [
            "verified",
            "task_failed",
            "missing_result",
            "verifier_missing",
            "execution_failed",
            "deadline_exceeded",
            "intervention_required",
            "budget_exhausted"
          ],
          "title": "Reason",
          "type": "string"
        },
        "reward": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reward"
        },
        "exception_type": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception Type"
        },
        "verifier_mode": {
          "enum": [
            "separate",
            "shared",
            "unknown"
          ],
          "title": "Verifier Mode",
          "type": "string"
        },
        "agent_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Agent Name",
          "type": "string"
        },
        "agent_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Version"
        },
        "native_reason": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "failed",
                "cancelled",
                "interrupted",
                "protocol_error",
                "deadline_exceeded",
                "intervention_required"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Reason"
        },
        "native_turn_status": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Turn Status"
        },
        "native_failure_category": {
          "anyOf": [
            {
              "enum": [
                "input",
                "provider",
                "tool",
                "approval",
                "budget",
                "cancelled",
                "interrupted",
                "storage",
                "conflict",
                "internal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Failure Category"
        },
        "observed_model_steps": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Model Steps"
        },
        "protocol_evidence_complete": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Evidence Complete"
        },
        "tool_results_succeeded": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Results Succeeded"
        },
        "final_assistant_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Assistant Sha256"
        },
        "observed_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Input Tokens"
        },
        "observed_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Output Tokens"
        },
        "reported_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Cost Usd"
        },
        "usage_completeness": {
          "const": "unknown",
          "default": "unknown",
          "title": "Usage Completeness",
          "type": "string"
        },
        "cost_completeness": {
          "const": "unknown",
          "default": "unknown",
          "title": "Cost Completeness",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        }
      },
      "required": [
        "slot",
        "slot_id",
        "task_name",
        "task_digest",
        "input_lock_sha256",
        "outcome",
        "classification",
        "reason",
        "verifier_mode",
        "agent_name"
      ],
      "title": "HarborEvalTrial",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "由Harbor冻结输入锁与结果重算的原生外部报告，不包含Prompt或异常正文。",
  "properties": {
    "spec_version": {
      "const": "harnessix.harbor-eval-report/v1",
      "default": "harnessix.harbor-eval-report/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "harbor_version": {
      "const": "0.25.0",
      "default": "0.25.0",
      "title": "Harbor Version",
      "type": "string"
    },
    "source_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Lock Sha256",
      "type": "string"
    },
    "source_job_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Job Result Sha256",
      "type": "string"
    },
    "reward_key": {
      "const": "reward",
      "default": "reward",
      "title": "Reward Key",
      "type": "string"
    },
    "pass_reward": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 1.0,
      "title": "Pass Reward",
      "type": "number"
    },
    "automatic_retries": {
      "default": 0,
      "maximum": 0,
      "minimum": 0,
      "title": "Automatic Retries",
      "type": "integer"
    },
    "source_timezone": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Timezone"
    },
    "plan_created_at": {
      "format": "date-time",
      "title": "Plan Created At",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/HarborEvalTrial"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Trials",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/HarborEvalSummary"
    }
  },
  "required": [
    "job_id",
    "source_lock_sha256",
    "source_job_result_sha256",
    "plan_created_at",
    "completed_at",
    "trials",
    "summary"
  ],
  "title": "HarborEvalReport",
  "type": "object"
}
