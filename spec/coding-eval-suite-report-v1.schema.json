            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FlatInputPrice"
            },
            {
              "$ref": "#/$defs/PartitionedInputPrice"
            }
          ],
          "title": "Input Price"
        },
        "output_per_million": {
          "maxLength": 25,
          "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,12})?$",
          "title": "Output Per Million",
          "type": "string"
        }
      },
      "required": [
        "version",
        "source_url",
        "billing_provider",
        "model",
        "region",
        "service_tier",
        "inference_mode",
        "currency",
        "valid_from",
        "valid_until",
        "input_tokens_min",
        "input_tokens_max",
        "input_price",
        "output_per_million"
      ],
      "title": "PriceSnapshot",
      "type": "object"
    },
