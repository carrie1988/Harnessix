{
  "$defs": {
    "BillingContext": {
      "additionalProperties": false,
      "description": "可信宿主核对的计费上下文；不是从 Adapter 类型或请求模型猜测。",
      "properties": {
        "billing_provider": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Billing Provider"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "service_tier": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Tier"
        },
        "inference_mode": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:/-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inference Mode"
        },
        "cache_write_ttl": {
          "anyOf": [
            {
              "enum": [
                "5m",
                "1h"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Ttl"
        }
      },
      "title": "BillingContext",
      "type": "object"
    },
    "CodingEvalCampaignPlan": {
      "additionalProperties": false,
      "description": "在任何真实请求前固定的可比较试验集合与计价上下文。",
      "properties": {
        "spec_version": {
          "const": "harnessix.coding-eval-campaign-plan/v1",
          "default": "harnessix.coding-eval-campaign-plan/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "campaign_id": {
          "format": "uuid",
          "title": "Campaign Id",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "minimum": 1,
          "title": "Task Version",
          "type": "integer"
        },
        "task_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Fingerprint",
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/CodingEvalEnvironment"
        },
        "run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Run Ids",
          "type": "array"
        },
        "price": {
          "$ref": "#/$defs/PriceSnapshot"
        },
        "billing_context": {
          "$ref": "#/$defs/BillingContext"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "campaign_id",
        "task_id",
        "task_version",
        "task_fingerprint",
        "environment",
        "run_ids",
        "price",
        "billing_context",
        "created_at"
      ],
      "title": "CodingEvalCampaignPlan",
      "type": "object"
    },
    "CodingEvalCampaignReport": {
      "additionalProperties": false,
      "properties": {
        "spec_version": {
          "const": "harnessix.coding-eval-campaign-report/v1",
          "default": "harnessix.coding-eval-campaign-report/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/CodingEvalCampaignPlan"
        },
        "plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Fingerprint",
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/CodingEvalCampaignTrial"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Trials",
          "type": "array"
        },
        "summary": {
          "$ref": "#/$defs/CodingEvalCampaignSummary"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "plan",
        "plan_fingerprint",
        "trials",
        "summary",
        "completed_at"
      ],
      "title": "CodingEvalCampaignReport",
      "type": "object"
    },
    "CodingEvalCampaignSummary": {
      "additionalProperties": false,
      "properties": {
        "scheduled_trials": {
          "maximum": 20,
          "minimum": 2,
          "title": "Scheduled Trials",
          "type": "integer"
        },
        "passed_trials": {
          "minimum": 0,
          "title": "Passed Trials",
          "type": "integer"
        },
        "provider_failed_trials": {
          "minimum": 0,
          "title": "Provider Failed Trials",
          "type": "integer"
        },
        "eval_infrastructure_failed_trials": {
          "minimum": 0,
          "title": "Eval Infrastructure Failed Trials",
          "type": "integer"
        },
        "runtime_failed_trials": {
          "minimum": 0,
          "title": "Runtime Failed Trials",
          "type": "integer"
        },
        "task_failed_trials": {
          "minimum": 0,
          "title": "Task Failed Trials",
          "type": "integer"
        },
        "budget_failed_trials": {
          "minimum": 0,
          "title": "Budget Failed Trials",
          "type": "integer"
        },
        "model_attempts": {
          "minimum": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_min_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Min Seconds",
          "type": "number"
        },
        "elapsed_p50_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P50 Seconds",
          "type": "number"
        },
        "elapsed_p95_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P95 Seconds",
          "type": "number"
        },
        "elapsed_max_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Max Seconds",
          "type": "number"
        },
        "cost_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Cost Completeness",
          "type": "string"
        },
        "known_cost_currency": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "CNY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Currency"
        },
        "known_cost_amount": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Amount"
        },
        "incomplete_cost_run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Incomplete Cost Run Ids",
          "type": "array"
        }
      },
      "required": [
        "scheduled_trials",
        "passed_trials",
        "provider_failed_trials",
        "eval_infrastructure_failed_trials",
        "runtime_failed_trials",
        "task_failed_trials",
        "budget_failed_trials",
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "elapsed_min_seconds",
        "elapsed_p50_seconds",
        "elapsed_p95_seconds",
        "elapsed_max_seconds",
        "cost_completeness",
        "incomplete_cost_run_ids"
      ],
      "title": "CodingEvalCampaignSummary",
      "type": "object"
    },
    "CodingEvalCampaignTrial": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "eval_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Eval Report Sha256",
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "turn_status": {
          "$ref": "#/$defs/TurnStatus"
        },
        "classification": {
          "enum": [
            "passed",
            "provider",
            "eval_infrastructure",
            "runtime",
            "task",
            "budget"
          ],
          "title": "Classification",
          "type": "string"
        },
        "eval_outcome": {
          "enum": [
            "passed",
            "failed",
            "invalid"
          ],
          "title": "Eval Outcome",
          "type": "string"
        },
        "failure_categories": {
          "items": {
            "enum": [
              "eval_infrastructure",
              "runtime",
              "correctness",
              "regression",
              "forbidden_edit",
              "final_answer",
              "budget"
            ],
            "type": "string"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "agent_failure_category": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureCategory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResponseFailed"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_models": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:/-]+$",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Actual Models",
          "type": "array"
        },
        "model_attempts": {
          "maximum": 32000,
          "minimum": 1,
          "title": "Model Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "cost_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Cost Completeness",
          "type": "string"
        },
        "known_cost_currency": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "CNY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Currency"
        },
        "known_cost_amount": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Amount"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "eval_report_sha256",
        "turn_id",
        "turn_status",
        "classification",
        "eval_outcome",
        "failure_categories",
        "actual_models",
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "elapsed_seconds",
        "cost_completeness",
        "started_at",
        "completed_at"
      ],
      "title": "CodingEvalCampaignTrial",
      "type": "object"
    },
    "CodingEvalEnvironment": {
      "additionalProperties": false,
      "properties": {
        "harnessix_revision": {
          "pattern": "^[0-9a-f]{40,64}$",
          "title": "Harnessix Revision",
          "type": "string"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "platform": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "isolation": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Isolation",
          "type": "string"
        }
      },
      "required": [
        "harnessix_revision",
        "provider",
        "model",
        "platform",
        "isolation"
      ],
      "title": "CodingEvalEnvironment",
      "type": "object"
    },
    "CodingEvalRate": {
      "additionalProperties": false,
      "description": "以分子、分母和四舍五入基点同时保存可重算比率。",
      "properties": {
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "minimum": 1,
          "title": "Denominator",
          "type": "integer"
        },
        "basis_points": {
          "maximum": 10000,
          "minimum": 0,
          "title": "Basis Points",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "basis_points"
      ],
      "title": "CodingEvalRate",
      "type": "object"
    },
    "CodingEvalSuiteCasePlan": {
      "additionalProperties": false,
      "description": "Suite冻结的单个任务、仓库和Campaign身份。",
      "properties": {
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "task_kind": {
          "enum": [
            "bug_fix",
            "feature",
            "refactor",
            "test",
            "review"
          ],
          "title": "Task Kind",
          "type": "string"
        },
        "task_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "task_version": {
          "minimum": 1,
          "title": "Task Version",
          "type": "integer"
        },
        "task_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Task Fingerprint",
          "type": "string"
        },
        "repository": {
          "$ref": "#/$defs/EvalRepository"
        },
        "campaign_plan_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Campaign Plan Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "task_kind",
        "task_id",
        "task_version",
        "task_fingerprint",
        "repository",
        "campaign_plan_fingerprint"
      ],
      "title": "CodingEvalSuiteCasePlan",
      "type": "object"
    },
    "CodingEvalSuiteCaseReport": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$",
          "title": "Case Id",
          "type": "string"
        },
        "campaign": {
          "$ref": "#/$defs/CodingEvalCampaignReport"
        },
        "campaign_report_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Campaign Report Fingerprint",
          "type": "string"
        },
        "transcripts": {
          "items": {
            "$ref": "#/$defs/CodingEvalTranscriptEvidence"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Transcripts",
          "type": "array"
        },
        "tests": {
          "items": {
            "$ref": "#/$defs/CodingEvalTrialTestEvidence"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Tests",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "campaign",
        "campaign_report_fingerprint",
        "transcripts",
        "tests"
      ],
      "title": "CodingEvalSuiteCaseReport",
      "type": "object"
    },
    "CodingEvalSuitePlan": {
      "additionalProperties": false,
      "description": "首个模型请求前固定的多任务、多仓库基线计划。",
      "properties": {
        "spec_version": {
          "const": "harnessix.coding-eval-suite-plan/v1",
          "default": "harnessix.coding-eval-suite-plan/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "suite_id": {
          "format": "uuid",
          "title": "Suite Id",
          "type": "string"
        },
        "suite_version": {
          "minimum": 1,
          "title": "Suite Version",
          "type": "integer"
        },
        "environment": {
          "$ref": "#/$defs/CodingEvalEnvironment"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/CodingEvalSuiteCasePlan"
          },
          "maxItems": 50,
          "minItems": 5,
          "title": "Cases",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "suite_id",
        "suite_version",
        "environment",
        "cases",
        "created_at"
      ],
      "title": "CodingEvalSuitePlan",
      "type": "object"
    },
    "CodingEvalSuiteSummary": {
      "additionalProperties": false,
      "properties": {
        "scheduled_cases": {
          "maximum": 50,
          "minimum": 5,
          "title": "Scheduled Cases",
          "type": "integer"
        },
        "repositories": {
          "maximum": 50,
          "minimum": 2,
          "title": "Repositories",
          "type": "integer"
        },
        "scheduled_trials": {
          "maximum": 1000,
          "minimum": 10,
          "title": "Scheduled Trials",
          "type": "integer"
        },
        "passed_trials": {
          "minimum": 0,
          "title": "Passed Trials",
          "type": "integer"
        },
        "tests_applicable_trials": {
          "minimum": 1,
          "title": "Tests Applicable Trials",
          "type": "integer"
        },
        "tests_passed_trials": {
          "minimum": 0,
          "title": "Tests Passed Trials",
          "type": "integer"
        },
        "human_intervention_trials": {
          "minimum": 0,
          "title": "Human Intervention Trials",
          "type": "integer"
        },
        "task_success_rate": {
          "$ref": "#/$defs/CodingEvalRate"
        },
        "test_pass_rate": {
          "$ref": "#/$defs/CodingEvalRate"
        },
        "human_intervention_rate": {
          "$ref": "#/$defs/CodingEvalRate"
        },
        "model_attempts": {
          "minimum": 0,
          "title": "Model Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_min_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Min Seconds",
          "type": "number"
        },
        "elapsed_p50_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P50 Seconds",
          "type": "number"
        },
        "elapsed_p95_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed P95 Seconds",
          "type": "number"
        },
        "elapsed_max_seconds": {
          "maximum": 86400,
          "minimum": 0,
          "title": "Elapsed Max Seconds",
          "type": "number"
        },
        "cost_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Cost Completeness",
          "type": "string"
        },
        "known_cost_currency": {
          "anyOf": [
            {
              "enum": [
                "USD",
                "CNY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Currency"
        },
        "known_cost_amount": {
          "anyOf": [
            {
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,18})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Cost Amount"
        },
        "incomplete_cost_run_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 1000,
          "title": "Incomplete Cost Run Ids",
          "type": "array"
        }
      },
      "required": [
        "scheduled_cases",
        "repositories",
        "scheduled_trials",
        "passed_trials",
        "tests_applicable_trials",
        "tests_passed_trials",
        "human_intervention_trials",
        "task_success_rate",
        "test_pass_rate",
        "human_intervention_rate",
        "model_attempts",
        "input_tokens",
        "output_tokens",
        "elapsed_min_seconds",
        "elapsed_p50_seconds",
        "elapsed_p95_seconds",
        "elapsed_max_seconds",
        "cost_completeness",
        "incomplete_cost_run_ids"
      ],
      "title": "CodingEvalSuiteSummary",
      "type": "object"
    },
    "CodingEvalTranscriptEvidence": {
      "additionalProperties": false,
      "description": "从持久Turn重算的脱敏Transcript结构和人工干预证据。",
      "properties": {
        "spec_version": {
          "const": "harnessix.coding-eval-transcript-evidence/v1",
          "default": "harnessix.coding-eval-transcript-evidence/v1",
          "title": "Spec Version",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "turn_status": {
          "$ref": "#/$defs/TurnStatus"
        },
        "transcript_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transcript Sha256",
          "type": "string"
        },
