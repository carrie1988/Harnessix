          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "input_tokens_min": {
          "minimum": 0,
          "title": "Input Tokens Min",
          "type": "integer"
        },
        "input_tokens_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Tokens Max"
        },
        "input_price": {
          "discriminator": {
            "mapping": {
              "flat": "#/$defs/FlatInputPrice",
              "partitioned": "#/$defs/PartitionedInputPrice"
