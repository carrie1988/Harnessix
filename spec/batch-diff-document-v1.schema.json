{
  "$defs": {
    "BatchDiffEdit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "patch_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Patch Fingerprint",
          "type": "string"
        },
        "edit_index": {
          "exclusiveMaximum": 32,
          "minimum": 0,
          "title": "Edit Index",
          "type": "integer"
        },
        "before_start": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Before Start",
          "type": "integer"
        },
        "after_start": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "After Start",
          "type": "integer"
        },
        "before": {
          "$ref": "#/$defs/DiffText"
        },
        "after": {
          "$ref": "#/$defs/DiffText"
        },
        "kind": {
          "const": "edit",
          "default": "edit",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "patch_fingerprint",
        "edit_index",
        "before_start",
        "after_start",
        "before",
        "after"
      ],
      "title": "BatchDiffEdit",
      "type": "object"
    },
    "BatchDiffFile": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "file",
          "default": "file",
          "title": "Kind",
          "type": "string"
        },
        "index": {
          "exclusiveMaximum": 16,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "patch_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Patch Fingerprint",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "before_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Before Bytes",
          "type": "integer"
        },
        "after_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "After Bytes",
          "type": "integer"
        },
        "total_edits": {
          "maximum": 32,
          "minimum": 1,
          "title": "Total Edits",
          "type": "integer"
        },
        "state": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "approved",
                "rejected",
                "started",
                "applied",
                "failed",
                "uncertain",
                "observed_before",
                "observed_after",
                "diverged",
                "missing",
                "unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "effect": {
          "anyOf": [
            {
              "enum": [
                "not_applied",
                "applied",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect"
        }
      },
      "required": [
        "index",
        "path",
        "patch_fingerprint",
        "before_sha256",
        "after_sha256",
        "before_bytes",
        "after_bytes",
        "total_edits"
      ],
      "title": "BatchDiffFile",
      "type": "object"
    },
    "BatchDiffSummary": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "summary",
          "default": "summary",
          "title": "Kind",
          "type": "string"
        },
        "version": {
          "const": "patch-batch-diff-document/v1",
          "default": "patch-batch-diff-document/v1",
          "title": "Version",
          "type": "string"
        },
        "view": {
          "enum": [
            "plan",
            "effect"
          ],
          "title": "View",
          "type": "string"
        },
        "batch_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Batch Fingerprint",
          "type": "string"
        },
        "phase": {
          "anyOf": [
            {
              "enum": [
                "not_started",
                "finished"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "completed",
                "cancelled",
                "timeout",
                "failed",
                "interrupted"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "effect": {
          "anyOf": [
            {
              "enum": [
                "not_applied",
                "applied",
                "partial",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect"
        },
        "total_files": {
          "maximum": 16,
          "minimum": 1,
          "title": "Total Files",
          "type": "integer"
        },
        "eligible_files": {
          "maximum": 16,
          "minimum": 0,
          "title": "Eligible Files",
          "type": "integer"
        },
        "total_edits": {
          "maximum": 512,
          "minimum": 1,
          "title": "Total Edits",
          "type": "integer"
        },
        "eligible_edits": {
          "maximum": 512,
          "minimum": 0,
          "title": "Eligible Edits",
          "type": "integer"
        },
        "returned_edits": {
          "maximum": 512,
          "minimum": 0,
          "title": "Returned Edits",
          "type": "integer"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        }
      },
      "required": [
        "view",
        "batch_fingerprint",
        "total_files",
        "eligible_files",
        "total_edits",
        "eligible_edits",
        "returned_edits",
        "complete"
      ],
      "title": "BatchDiffSummary",
      "type": "object"
    },
    "DiffText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 4096,
          "title": "Text",
          "type": "string"
        },
        "total_bytes": {
          "maximum": 131072,
          "minimum": 0,
          "title": "Total Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "total_bytes",
        "sha256",
        "truncated"
      ],
      "title": "DiffText",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "summary": {
      "$ref": "#/$defs/BatchDiffSummary"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/BatchDiffFile"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "edits": {
      "items": {
        "$ref": "#/$defs/BatchDiffEdit"
      },
      "maxItems": 512,
      "title": "Edits",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "files",
    "edits"
  ],
  "title": "BatchDiffDocument",
  "type": "object"
}
