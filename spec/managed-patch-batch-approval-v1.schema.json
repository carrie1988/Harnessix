{
  "$defs": {
    "ApprovalDecision": {
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "$ref": "#/$defs/ApprovalOutcome"
        },
        "actor": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Actor",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "outcome",
        "actor"
      ],
      "title": "ApprovalDecision",
      "type": "object"
    },
    "ApprovalOutcome": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "ApprovalOutcome",
      "type": "string"
    },
    "ManagedPatchBatchPlan": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "managed-patch-batch-plan/v1",
          "default": "managed-patch-batch-plan/v1",
          "title": "Version",
          "type": "string"
        },
        "batch_id": {
          "format": "uuid",
          "title": "Batch Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "manifest": {
          "$ref": "#/$defs/PatchBatchManifest"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/PatchBatchMember"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        },
        "approval_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "batch_id",
        "workspace_id",
        "request_id",
        "manifest",
        "members",
        "approval_fingerprint"
      ],
      "title": "ManagedPatchBatchPlan",
      "type": "object"
    },
    "PatchBatchManifest": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "patch-batch-plan/v1",
          "default": "patch-batch-plan/v1",
          "title": "Version",
          "type": "string"
        },
        "workspace_scope": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workspace Scope",
          "type": "string"
        },
        "proposal_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposal Sha256",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/PatchManifest"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "workspace_scope",
        "proposal_sha256",
        "files",
        "fingerprint"
      ],
      "title": "PatchBatchManifest",
      "type": "object"
    },
    "PatchBatchMember": {
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "format": "uuid",
          "title": "Plan Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Id",
          "type": "string"
        },
        "approval_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Approval Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "plan_id",
        "request_id",
        "approval_fingerprint"
      ],
      "title": "PatchBatchMember",
      "type": "object"
    },
    "PatchManifest": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "patch-plan/v1",
          "default": "patch-plan/v1",
          "title": "Version",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "workspace_scope": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workspace Scope",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_mode": {
          "maximum": 511,
          "minimum": 0,
          "title": "Source Mode",
          "type": "integer"
        },
        "proposal_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposal Sha256",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "before_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Before Bytes",
          "type": "integer"
        },
        "after_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "After Bytes",
          "type": "integer"
        },
        "edit_count": {
          "maximum": 32,
          "minimum": 1,
          "title": "Edit Count",
          "type": "integer"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "path",
        "workspace_scope",
        "source_revision",
        "source_mode",
        "proposal_sha256",
        "before_sha256",
        "after_sha256",
        "before_bytes",
        "after_bytes",
        "edit_count",
        "fingerprint"
      ],
      "title": "PatchManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "managed-patch-batch-approval/v1",
      "default": "managed-patch-batch-approval/v1",
      "title": "Version",
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ManagedPatchBatchPlan"
    },
    "decision": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "plan"
  ],
  "title": "ManagedPatchBatchApproval",
  "type": "object"
}
