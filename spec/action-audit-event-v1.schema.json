{
  "$defs": {
    "ApprovalOutcome": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "ApprovalOutcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "harnessix.action-audit-event/v1",
      "default": "harnessix.action-audit-event/v1",
      "title": "Spec Version",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Fingerprint",
      "type": "string"
    },
    "sequence": {
      "maximum": 256,
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "from_state": {
      "anyOf": [
        {
          "enum": [
            "denied",
            "pending_approval",
            "ready",
            "running",
            "succeeded",
            "failed",
            "unknown",
            "reconciling",
            "manual_intervention"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "From State"
    },
    "to_state": {
      "enum": [
        "denied",
        "pending_approval",
        "ready",
        "running",
        "succeeded",
        "failed",
        "unknown",
        "reconciling",
        "manual_intervention"
      ],
      "title": "To State",
      "type": "string"
    },
    "resource_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resource Sha256",
      "type": "string"
    },
    "policy_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "approval_outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_actor_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approval Actor Sha256"
    },
    "executor_id": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executor Id"
    },
    "output_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Sha256"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Sha256"
    },
    "external_action_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Action Id"
    },
    "error_code": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "reconciliation": {
      "anyOf": [
        {
          "enum": [
            "succeeded",
            "failed",
            "unknown",
            "manual_intervention"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reconciliation"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "previous_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Digest"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    }
  },
  "required": [
    "plan_id",
    "plan_fingerprint",
    "sequence",
    "from_state",
    "to_state",
    "resource_sha256",
    "policy_id",
    "policy_version",
    "digest"
  ],
  "title": "ActionAuditEvent",
  "type": "object"
}
