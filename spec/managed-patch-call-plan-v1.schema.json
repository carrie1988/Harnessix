{
  "$defs": {
    "PatchManifest": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "patch-plan/v1",
          "default": "patch-plan/v1",
          "title": "Version",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "workspace_scope": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workspace Scope",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Revision",
          "type": "string"
        },
        "source_mode": {
          "maximum": 511,
          "minimum": 0,
          "title": "Source Mode",
          "type": "integer"
        },
        "proposal_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposal Sha256",
          "type": "string"
        },
        "before_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Before Sha256",
          "type": "string"
        },
        "after_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "After Sha256",
          "type": "string"
        },
        "before_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "Before Bytes",
          "type": "integer"
        },
        "after_bytes": {
          "maximum": 1048576,
          "minimum": 0,
          "title": "After Bytes",
          "type": "integer"
        },
        "edit_count": {
          "maximum": 32,
          "minimum": 1,
          "title": "Edit Count",
          "type": "integer"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "path",
        "workspace_scope",
        "source_revision",
        "source_mode",
        "proposal_sha256",
        "before_sha256",
        "after_sha256",
        "before_bytes",
        "after_bytes",
        "edit_count",
        "fingerprint"
      ],
      "title": "PatchManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "managed-patch-call/v1",
      "default": "managed-patch-call/v1",
      "title": "Version",
      "type": "string"
    },
    "thread_id": {
      "format": "uuid",
      "title": "Thread Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    },
    "call_id": {
      "format": "uuid",
      "title": "Call Id",
      "type": "string"
    },
    "call_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Call Fingerprint",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    },
    "plan_id": {
      "format": "uuid",
      "title": "Plan Id",
      "type": "string"
    },
    "manifest": {
      "$ref": "#/$defs/PatchManifest"
    },
    "backend_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Backend Fingerprint",
      "type": "string"
    },
    "approval_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Approval Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "thread_id",
    "turn_id",
    "call_id",
    "call_fingerprint",
    "request_id",
    "workspace_id",
    "plan_id",
    "manifest",
    "backend_fingerprint",
    "approval_fingerprint"
  ],
  "title": "ManagedPatchCallPlan",
  "type": "object"
}
