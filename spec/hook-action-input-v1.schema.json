    "target_action_source_id_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Action Source Id Sha256"
    },
    "target_action_tool": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Action Tool"
    },
    "target_action_plan_id": {
      "anyOf": [
        {
          "format": "uuid",
