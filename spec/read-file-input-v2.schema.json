{
  "additionalProperties": false,
  "description": "显式限制文本页字节数；旧v1输入及其24 KiB默认值保持不变。",
  "properties": {
    "path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Path",
      "type": "string"
    },
    "start_line": {
      "default": 1,
      "maximum": 2097152,
      "minimum": 1,
      "title": "Start Line",
      "type": "integer"
    },
    "max_lines": {
      "default": 200,
      "maximum": 2000,
      "minimum": 1,
      "title": "Max Lines",
      "type": "integer"
    },
    "expected_revision": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Revision"
    },
    "max_utf8_bytes": {
      "default": 24576,
      "description": "本页文本UTF-8字节上限，不是Token数；整行分页，可用next_line继续",
      "maximum": 24576,
      "minimum": 4096,
      "title": "Max Utf8 Bytes",
      "type": "integer"
    }
  },
  "required": [
    "path"
  ],
  "title": "ReadFileInputV2",
  "type": "object"
}
